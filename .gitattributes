# Update-conformance fixtures are byte-exact by construction: latest.json.sig
# is an Ed25519 signature over the literal bytes of latest.json, and
# artifact.bin / artifact.exe are checked against a sha256 digest pinned in a
# signed manifest. Git on Windows defaults to core.autocrlf=true, which
# rewrites LF to CRLF for any file it classifies as text on checkout. That
# silently changes the bytes these fixtures are made of, so a signature that
# was valid at commit time fails to verify after checkout -- not because the
# fixture or the verifier is wrong, but because the file the test reads is no
# longer the file that was signed. `-text` opts every fixture format in this
# tree out of that translation on every platform, so the checked-out bytes
# always match the committed bytes exactly.
tests/fixtures/update-conformance/**/*.json -text
tests/fixtures/update-conformance/**/*.sig  -text
tests/fixtures/update-conformance/**/*.pem  -text
tests/fixtures/update-conformance/**/*.hex  -text
tests/fixtures/update-conformance/**/*.bin  -text
tests/fixtures/update-conformance/**/*.exe  -text

# The Orchard-generated worker IPC compatibility fixture is pinned by a SHA-256
# over its exact committed bytes (worker_protocol.rs, and the digest published
# in docs/compute-local-adapter.md). Same hazard as above: an autocrlf checkout
# on Windows would rewrite its line endings and break a digest that is correct.
crates/trace-commons-contributor/tests/fixtures/orchard_worker_ipc_v0.json -text

# This writer fixture package pins the source, manifest, and generator hashes.
# Preserve their exact bytes on Windows as well as Unix checkouts.
crates/trace-commons-contributor/fixtures/insights/codex-task-attribution/* -text

# Preserve the pinned upstream SDK bytes, including its trailing whitespace.
crates/trace-commons-contributor/src/daemon/nearai_credential/near_connect/near-connect-0.11.4.js -text whitespace=-blank-at-eol

# Comparison-estimator fixtures and reviewed calibration/runtime evidence are
# pinned to their exact committed bytes. Rust golden tests and SHA-256 manifests
# intentionally distinguish every byte, so Windows autocrlf translation must
# not rewrite JSON, JSONL, Markdown, or manifest line endings in this tree.
crates/trace-commons-contributor/fixtures/insights/comparison-estimator/** -text
