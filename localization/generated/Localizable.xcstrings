      }
    },
    "inference_connection_copy.grants_nothing": {
      "comment": "[sensitive] Inference connection: authentication alone grants no contribution permission. Field: inference_connection_copy.grants_nothing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting chooses no folders or traces, does not change how your traces may be used, and does not turn on automatic contributing."
