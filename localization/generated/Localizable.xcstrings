    "inference_connection_copy.disconnect": {
      "comment": "[sensitive] Inference connection: authentication alone grants no contribution permission. Field: inference_connection_copy.disconnect.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnecting removes this connection's witness from this device, then ends the connection on your account."
