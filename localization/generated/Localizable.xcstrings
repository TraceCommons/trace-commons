          }
        }
      }
    },
    "contribution_attestation_reason_line.body_too_large": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.body_too_large.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kept copy of this trace's last model call is larger than this app will carry."
          }
        }
      }
    },
    "contribution_attestation_reason_line.capture_off": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.capture_off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last model call in this trace was answered without keeping a copy of it. Whether copies are kept is a setting, and it decides the traces you record from now on."
          }
        }
      }
    },
    "contribution_attestation_reason_line.digest_absent": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.digest_absent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last model call in this trace did not finish cleanly, so what was kept of it is incomplete."
          }
        }
      }
    },
    "contribution_attestation_reason_line.digest_mismatch": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.digest_mismatch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was kept of the last model call in this trace does not match what was written down about it, so nothing can be checked against it."
          }
        }
      }
    },
    "contribution_attestation_reason_line.evidence_capture_off": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.evidence_capture_off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer keeps no copy of the model calls it answers, so no trace recorded here has one to carry. That is a setting you can change."
          }
        }
      }
    },
    "contribution_attestation_reason_line.fallback": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.fallback.",
