      }
    },
    "inference_connection_copy.install": {
      "comment": "[sensitive] Inference connection: authentication alone grants no contribution permission. Field: inference_connection_copy.install.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Using this connection's witness on this device is a separate step. It changes who reads your traces, so any automatic contributing already turned on here stops, and you are asked again before it restarts."
          }
        }
      }
    },
