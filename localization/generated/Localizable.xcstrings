      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        }
      }
    },
    "witness_copy.review.confirm": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.confirm.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send"
          }
        }
      }
    },
    "witness_copy.review.disclosure": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.disclosure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sends this trace, including its unredacted conversation and any correction you include, to your configured remote witness before you approve a contribution. It may contain prompts, tool results, personal data, or secrets. Captured inference bodies are included only with the separate saved permission. You can inspect the returned redacted contribution before deciding whether to send it. Cancelling afterwards cannot recall a trace already sent to the witness."
          }
        }
      }
    },
    "witness_copy.review.failed": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The witness review could not be confirmed. The trace may already have reached the witness. No contribution has been approved here. Try again only if you want to send another review request."
          }
        }
      }
    },
    "witness_copy.review.failed_bodies_returned": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_bodies_returned.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review was refused, because what came back still held the model text it was given, which a finished review never does. That trace has not been approved and will not be sent. Ask whoever runs your commons about it before reviewing anything else."
          }
        }
      }
    },
    "witness_copy.review.failed_busy": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_busy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review could not go ahead yet, because the privacy witness is busy checking other traces. Nothing was sent and nothing has been approved. It will be free again soon."
          }
        }
      }
    },
    "witness_copy.review.failed_host_not_allowed": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_host_not_allowed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review could not go ahead, because the reviewer's address is not on the allowed list for this computer. Nothing left the machine. Whoever set this computer up needs to allow it."
          }
        }
      }
    },
    "witness_copy.review.failed_measurement_unpinned": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_measurement_unpinned.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review could not go ahead, because this computer has nothing recorded to check the reviewer against, or what it reported did not match. Nothing was sent. Record the value your commons publishes for its reviewer, then try again."
          }
        }
      }
    },
    "witness_copy.review.failed_not_connected": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_not_connected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review could not go ahead, because this computer is not connected to a commons yet. Finish joining, then come back to this trace."
          }
        }
      }
    },
    "witness_copy.review.failed_receipt_declined": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_receipt_declined.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review was refused, because the reviewer would not accept the signature covering this trace's model call -- which one answered, which model, or how small the request was. Nothing has been approved. This is a setting where your commons runs, not here, so ask its operator. You can still contribute existing history without it."
          }
        }
      }
    },
    "witness_copy.review.failed_too_large": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_too_large.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace is larger than the review will carry, so nothing was offered and nothing left the machine. It cannot be contributed this way."
          }
        }
      }
    },
    "witness_copy.review.failed_unproven": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_unproven.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review was refused, because the reviewer could not show it is the one you recorded. Nothing was sent onward and nothing has been approved. This is deliberate -- a reviewer that cannot prove itself does not get used. Ask whoever runs your commons before trying again."
          }
        }
      }
    },
    "witness_copy.review.failed_unreachable": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.failed_unreachable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The review could not go ahead, because the reviewer did not answer, or answered something this app could not read. Nothing has been approved and nothing has been lost. Try again in a little while."
          }
        }
      }
    },
    "witness_copy.review.heading": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.review.heading.",
      "extractionState": "manual",
      "localizations": {
