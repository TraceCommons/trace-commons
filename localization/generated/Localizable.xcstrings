          "stringUnit": {
            "state": "translated",
            "value": "Withdraw this trace?\n\nIts content will be deleted from managed stores and excluded from future exports. If copies were already distributed, they cannot be recalled.\n\nCredit that has already settled stays. Credit still pending is forfeited."
          }
        }
      }
