    "contribution_attestation_reason_line.marker_absent": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.marker_absent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last model call in this trace went out without the mark a kept copy is checked against. It was made before that was set up, or by a tool that does not add it."
