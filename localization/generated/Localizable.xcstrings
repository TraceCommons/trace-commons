      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For new inference evidence, this adds an account-bound challenge to the next request in this trace. Use your own funded NEAR AI backend, then continue the agent task and return here to review. You can separately choose witness review of eligible existing history, subject to server limits."
          }
        }
      }
    },
    "witness_copy.admission.failed": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared. Check your supported agent, backend, and capture settings, then try again."
          }
        }
      }
    },
    "witness_copy.admission.failed_backend": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_backend.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, because the backend name given for it cannot be used. Choose a backend from the list and confirm again."
          }
        }
      }
    },
    "witness_copy.admission.failed_hosts_untrusted": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_hosts_untrusted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, because one of the addresses it must call is not on the allowed-hosts list for this computer. Whoever set this computer up needs to allow it. Nothing left the machine."
          }
        }
      }
    },
    "witness_copy.admission.failed_not_enrolled": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_not_enrolled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, because this computer is not connected to a commons yet. Finish joining, then come back to this trace."
          }
        }
      }
    },
    "witness_copy.admission.failed_permission": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_permission.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, because sending captured inference bodies has not been permitted. Open Settings and give that permission, then confirm this trace again. Nothing is sent until you do."
          }
        }
      }
    },
    "witness_copy.admission.failed_proxy_missing": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_proxy_missing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, because the local proxy that records model calls is not running or is not capturing them. Start it and turn on body capture, then confirm this trace again."
          }
        }
      }
    },
    "witness_copy.admission.failed_proxy_untrusted": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_proxy_untrusted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, because the local proxy's control file did not pass its safety check. Nothing was sent. Restart the proxy so it writes a fresh one, and if it keeps happening, ask for help before retrying."
          }
        }
      }
    },
    "witness_copy.admission.failed_receipt_endpoint": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_receipt_endpoint.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, and nothing in your settings will fix it. Your commons has not published a receipt service, so there is nowhere to collect the provider's signature for this inference. Ask the operator of your commons to publish one. You can still contribute existing history without it."
          }
        }
      }
    },
    "witness_copy.admission.failed_receipt_endpoint_invalid": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_receipt_endpoint_invalid.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared. The receipt service configured for this computer is not an address this app will call, so the provider's signature cannot be collected. Whoever set it up needs to correct it. You can still contribute existing history without it."
          }
        }
      }
    },
    "witness_copy.admission.failed_session_unreadable": {
      "comment": "[sensitive] Witness and wallet settings: preserve verification limits and disclosure scope. Field: witness_copy.admission.failed_session_unreadable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace could not be prepared, because its file could not be read back. It may have been moved, deleted, or still be in use by the agent. Pick another trace, or close the agent and try again."
          }
        }
      }
    },
    "witness_copy.admission.failed_source_unsupported": {
