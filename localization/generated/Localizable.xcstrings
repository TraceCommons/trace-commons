    "private_inference_copy.attestation_attested": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_attested.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace carries a checkable copy of its last model call."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_bodies_unreadable": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_bodies_unreadable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kept copy of this trace's last model call could not be read back from this computer."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_body_not_utf8": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_body_not_utf8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kept copy of this trace's last model call is not text this app can carry without changing it, and changing it would make it worthless."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_body_too_large": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_body_too_large.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The kept copy of this trace's last model call is larger than this app will carry."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_capture_off": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_capture_off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last model call in this trace was answered without keeping a copy of it. Whether copies are kept is a setting, and it decides the traces you record from now on."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_digest_absent": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_digest_absent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last model call in this trace did not finish cleanly, so what was kept of it is incomplete."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_digest_mismatch": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_digest_mismatch.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was kept of the last model call in this trace does not match what was written down about it, so nothing can be checked against it."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_evidence_capture_off": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_evidence_capture_off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This computer keeps no copy of the model calls it answers, so no trace recorded here has one to carry. That is a setting you can change."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_marker_absent": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_marker_absent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last model call in this trace went out without the mark a kept copy is checked against. It was made before that was set up, or by a tool that does not add it."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_no_call": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_no_call.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model call was answered on this computer while this trace ran, so there is nothing to attach to it."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_receipt_not_issued": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_receipt_not_issued.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model that answered this trace does not provide a copy-of-call proof. A model the provider runs itself can; one it only passes along cannot."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_receipt_unavailable": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_receipt_unavailable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The proof that goes with this trace's last model call could not be fetched just now. It may work later."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_reference_malformed": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_reference_malformed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The note saying where this trace's kept copy lives is not one this computer could have written."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_request_malformed": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_request_malformed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last model call in this trace was not written down in a shape this app can read, so the mark cannot be found in it."
          }
        }
      }
    },
    "private_inference_copy.attestation_reason_upstream_id_absent": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_reason_upstream_id_absent.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was written down for the last model call in this trace that would let anyone check it afterwards."
          }
        }
      }
    },
    "private_inference_copy.attestation_unattested_configuration": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.attestation_unattested_configuration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This trace carries no copy of its last model call. A setting decides whether the ones you record from now on will."
          }
        }
      }
