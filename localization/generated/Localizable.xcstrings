    "privacy_scan_copy.disclosure": {
      "comment": "[sensitive] Privacy scan: uncertainty is not a guarantee that a trace contains no secrets. Field: privacy_scan_copy.disclosure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This means your message text is transmitted to NEAR AI before it reaches the server that receives your traces. If that scanner is unreachable, nothing is sent at all — traces wait rather than going out unscanned."
          }
        }
      }
    },
    "privacy_scan_copy.local_always": {
      "comment": "[sensitive] Privacy scan: uncertainty is not a guarantee that a trace contains no secrets. Field: privacy_scan_copy.local_always.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local scrubbing removes secrets, keys, tokens and credentials by pattern before anything leaves this machine. It runs either way."
          }
        }
      }
    },
    "privacy_scan_copy.local_only": {
      "comment": "[sensitive] Privacy scan: uncertainty is not a guarantee that a trace contains no secrets. Field: privacy_scan_copy.local_only.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local scrubbing only"
          }
        }
      }
    },
    "privacy_scan_copy.offer": {
      "comment": "[sensitive] Privacy scan: uncertainty is not a guarantee that a trace contains no secrets. Field: privacy_scan_copy.offer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can additionally send the message text of each trace — not tool output, not file contents — through a second scanner run by NEAR AI, a third party, to catch personal information the patterns miss: names, addresses, that kind of thing."
          }
        }
      }
    },
    "privacy_scan_copy.recovery_action": {
      "comment": "[sensitive] Privacy scan: uncertainty is not a guarantee that a trace contains no secrets. Field: privacy_scan_copy.recovery_action.",
