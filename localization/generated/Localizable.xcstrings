    "consent_copy.auto_no_review": {
      "comment": "[sensitive] Consent decision: preserve exact scope, destination and consequences before the action. Field: consent_copy.auto_no_review.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Submissions are automatically queued and sent without review. You can withdraw them from future use; distributed copies cannot be recalled."
          }
        }
      }
    },
    "consent_copy.auto_scrub_limit": {
      "comment": "[sensitive] Consent decision: preserve exact scope, destination and consequences before the action. Field: consent_copy.auto_scrub_limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The patterns are reliable for the formats they cover. Beyond those, in text they catch only a long, random-looking value right after a word like \"password\" or \"token\", and are blind to everything else. The model is not reliable. Nothing here checks whether either of them was right."
          }
        }
      }
    },
    "consent_copy.auto_scrub_scope": {
      "comment": "[sensitive] Consent decision: preserve exact scope, destination and consequences before the action. Field: consent_copy.auto_scrub_scope.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed patterns remove API keys and tokens in the formats we know, and many file paths and email addresses that name you. A bearer token in any other format is removed when it is long, looks random and follows \"Bearer\" after a space or colon, unless it is shaped like a UUID or another known kind of ID; one that is short, or run straight onto \"Bearer\", can get through. Everything else -- names, people, addresses, account numbers, a password typed into a sentence -- is removed when a model recognises it."
          }
        }
      }
    },
    "consent_copy.gate_statement": {
      "comment": "[sensitive] Consent decision: preserve exact scope, destination and consequences before the action. Field: consent_copy.gate_statement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Exactly what would be sent\" is the exact text that would leave this machine. Pattern-based scrubbing may have missed something in it, and nothing here checks that you looked."
          }
        }
      }
    },
    "consent_copy.not_pinned_help": {
      "comment": "[sensitive] Consent decision: preserve exact scope, destination and consequences before the action. Field: consent_copy.not_pinned_help.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device isn't connected yet, so this preview was built without your identity and nothing here can be contributed."
