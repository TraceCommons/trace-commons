    "contribution_attestation_reason_line.body_not_utf8": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.body_not_utf8.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
