    },
    "inference_connection_copy.disconnect_pending": {
      "comment": "[sensitive] Inference connection: authentication alone grants no contribution permission. Field: inference_connection_copy.disconnect_pending.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The witness was removed from this device, but the connection on your account could not be ended yet. Sign in and disconnect again to finish."
          }
