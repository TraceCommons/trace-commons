    "message.automatic_grant_copy_json.model_scrubbed.limit": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: message.automatic_grant_copy_json.model_scrubbed.limit.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The patterns are reliable for the formats they cover. Beyond those, in text they catch only a long, random-looking value right after a word like \"password\" or \"token\", and are blind to everything else. The model is not reliable. Nothing here checks whether either of them was right."
          }
        }
      }
    },
    "message.automatic_grant_copy_json.model_scrubbed.no_review": {
