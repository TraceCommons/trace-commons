    },
    "contribution_attestation_reason_line.receipt_not_issued": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: contribution_attestation_reason_line.receipt_not_issued.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model that answered this trace does not provide a copy-of-call proof. A model the provider runs itself can; one it only passes along cannot."
          }
        }
      }
    },
    "contribution_attestation_reason_line.receipt_unavailable": {
