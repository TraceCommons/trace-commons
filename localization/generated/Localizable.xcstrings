        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "1 approved trace is waiting because the privacy witness is busy checking other traces. Nothing is sent until the witness can check it. It will be tried again automatically, and nothing has been lost."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld approved traces are waiting because the privacy witness is busy checking other traces. Nothing is sent until the witness can check them. They will be tried again automatically, and nothing has been lost."
