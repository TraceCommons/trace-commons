        }
      }
    },
    "private_inference_copy.eligibility_reason_evidence_capture_off": {
      "comment": "[sensitive] Private AI offer and settings: preserve limits of observed routing and attestation. Field: private_inference_copy.eligibility_reason_evidence_capture_off.",
