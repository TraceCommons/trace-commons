    "message.contribution_override_confirm_json.ignore.body": {
      "comment": "[sensitive] Core-selected presentation: preserve scope, uncertainty and consequences. Field: message.contribution_override_confirm_json.ignore.body.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is queued or sent from any folder until you turn this off, including traces you already approved.\n\nTurning this off puts each folder back on its own setting, and traces you approved are sent. Traces you finish in the meantime are then treated by that setting, so a folder set to contribute automatically sends them without asking."
