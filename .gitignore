/target/
# The GTK shell is its own cargo workspace (excluded from the root one so the
# root builds on macOS), so its build output is NOT covered by the anchored
# /target/ above. Without this, a `git add -A` in that worktree stages a few
# hundred build artifacts.
crates/trace-commons-contributor-gtk/target/
/.env
/.env.*
!/.env.example

# Local git worktrees for parallel feature work
.worktrees/

# Local Cloudflare/Wrangler state
community/.wrangler/
.superpowers/

# Local adversarial review artifacts (pre-PR gate)
.review/

# Operator exports can contain submission-level analysis data
scripts/operator/*.csv

# Local pre-PR review artifacts
.review/

# Generated per release by scripts/winget/generate-manifests.sh and submitted to
# microsoft/winget-pkgs, not carried here -- the InstallerSha256 is only valid
# for one specific published artifact.
manifests/

# CPython bytecode, written beside any script under scripts/ the moment it is
# run or imported. One of these reached main because it was sitting untracked
# in a working tree when a broad `git add` swept it up; ignoring it stops the
# next one, and stops the churn of a regenerated .pyc showing as a change.
__pycache__/
*.py[cod]
