date -u +%Y%m%dT%H%M%SZ
sudo install -o tracecommons -g tracecommons -m 755 ~/trace-commons-server/target/release/trace-commons-ingest /opt/tracecommons/bin/
sudo install -o tracecommons -g tracecommons -m 755 ~/trace-commons-server/target/release/trace-commons-upload-claim-issuer /opt/tracecommons/bin/
sudo install -d -o tracecommons -g tracecommons -m 750 /var/lib/trace-commons-vector-index
sudo install -d -o tracecommons -g tracecommons -m 750 /var/lib/trace-commons-dedup-index
sudo install -d -o tracecommons -g tracecommons -m 750 /var/lib/trace-commons-data
sudo install -d -o tracecommons -g tracecommons -m 750 /var/cache/trace-commons-embedder
sudo install -o root -g tracecommons -m 640 ~/deploy/ingest.env /etc/tracecommons/ingest.env
sudo install -o root -g tracecommons -m 640 ~/deploy/issuer.env /etc/tracecommons/issuer.env
sudo install -m 644 ~/deploy/trace-commons-ingest.service /etc/systemd/system/
sudo install -m 644 ~/deploy/trace-commons-upload-claim-issuer.service /etc/systemd/system/
sudo install -m 644 ~/deploy/cloud-sql-proxy.service /etc/systemd/system/
sudo install -m 644 ~/deploy/Caddyfile /etc/caddy/Caddyfile
sudo systemctl daemon-reload
sudo systemctl enable --now cloud-sql-proxy.service
sleep 3
sudo systemctl is-active cloud-sql-proxy.service
sudo systemctl enable --now trace-commons-upload-claim-issuer.service
sleep 3
sudo systemctl is-active trace-commons-upload-claim-issuer.service
curl -sfS http://127.0.0.1:3917/health
sudo systemctl reload caddy
sleep 5
curl -sfk https://issuer.pilot.example.invalid/health -o /tmp/issuer-health.out
curl -sf https://issuer.pilot.example.invalid/.well-known/trace-commons-ed25519-keyset.json
sudo systemctl enable --now trace-commons-ingest.service
sleep 8
sudo systemctl is-active trace-commons-ingest.service
curl -sfS --connect-timeout 2 --max-time 5 http://127.0.0.1:3907/health
curl -sf https://ingest.pilot.example.invalid/health
curl -sfS https://ingest.pilot.example.invalid/v1/source
