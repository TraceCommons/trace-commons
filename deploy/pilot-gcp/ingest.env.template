# trace-commons-ingest pilot config template
#
# Render before staging on the host (e.g. via envsubst), then install as
# /etc/tracecommons/ingest.env (mode 0640 root:tracecommons). Never commit
# the rendered file; secrets stay in the operator key vault.
#
# Placeholders:
#   ${TC_DB_PASSWORD}           Cloud SQL app-role password
#   ${TC_GCP_PROJECT}           e.g. tracecommons-pilot-2026
#   ${TC_GCP_REGION}            e.g. us-central1
#   ${TC_KMS_KEY_NAME}          full KMS key resource path
#   ${TC_GCS_BUCKET}            artifact bucket, e.g. tc-pilot-artifacts-20260518
#   ${TC_RUNTIME_SA}            runtime service account email
#   ${TC_PUBLIC_HOST}           e.g. 34-41-15-28.nip.io
#   ${TC_GATE_MASTER_KEY_HEX}   hex-encoded master key for the gate-service envelope crypto
#   ${TC_NEAR_AI_API_KEY}       NEAR AI Cloud API key
#   ${TC_ARTIFACT_KEY_HEX}      hex-encoded artifact-encryption key
#   ${TC_LOGIN_RESOLVER_PASSWORD}  Cloud SQL tc_login_resolver_login role password
#   ${TC_PII_BACKSTOP_DRIVER_PASSWORD}  Cloud SQL tc_pii_backstop_driver_login role password (optional; PII backstop)

# Network
TRACE_COMMONS_BIND=127.0.0.1:3907

# Database — connects to the Cloud SQL Auth Proxy sidecar on loopback.
# The proxy terminates mTLS to Cloud SQL using the runtime service account.
DATABASE_URL=postgres://app:${TC_DB_PASSWORD}@127.0.0.1:5432/trace-commons

# KEK / object store (GCP)
TRACE_COMMONS_KEK_PROVIDER=gcp_cloud_kms
TRACE_COMMONS_KEK_GCP_KMS_KEY_NAME=${TC_KMS_KEY_NAME}
TRACE_COMMONS_KEK_REQUIRE_PRODUCTION_TRUST_BOUNDARY=true
TRACE_COMMONS_REMOTE_OBJECT_STORE_PROVIDER=gcs
TRACE_COMMONS_REMOTE_OBJECT_STORE_BUCKET=${TC_GCS_BUCKET}
TRACE_COMMONS_REMOTE_OBJECT_STORE_KMS_KEY_ID=${TC_KMS_KEY_NAME}
TRACE_COMMONS_OBJECT_STORE_REQUIRE_VERSIONING=true

# Auth — verify EdDSA-signed upload claims against the issuer's JWKS.
TRACE_COMMONS_REQUIRE_EDDSA_SIGNED_TOKENS=true
TRACE_COMMONS_REQUIRE_MANAGED_EDDSA_SIGNED_TOKENS=true
TRACE_COMMONS_SIGNED_TOKEN_EDDSA_KEYSET_URL=https://issuer.${TC_PUBLIC_HOST}/.well-known/trace-commons-ed25519-keyset.json
TRACE_COMMONS_SIGNED_TOKEN_EDDSA_KEYSET_URL_ALLOWED_HOSTS=issuer.${TC_PUBLIC_HOST}
TRACE_COMMONS_SIGNED_TOKEN_ISSUER=https://issuer.${TC_PUBLIC_HOST}
TRACE_COMMONS_SIGNED_TOKEN_AUDIENCE=trace-commons-ingest
TRACE_COMMONS_SIGNED_TOKEN_REQUIRE_JTI=true
# Tenant access grants stay DB-enforced; flip on once grants are loaded.
TRACE_COMMONS_REQUIRE_TENANT_ACCESS_GRANTS=false

# Gate service — NEAR AI Cloud variant. Calibrate floors after the first
# ~1000 traces; perplexity + tail-fraction stay at 0 at launch.
TRACE_COMMONS_GATE_SERVICE=enclave_near_ai
TRACE_COMMONS_GATE_SERVICE_MASTER_KEY=${TC_GATE_MASTER_KEY_HEX}
TRACE_COMMONS_NEAR_AI_BASE_URL=https://qwen3-6-35b.completions.near.ai/v1
TRACE_COMMONS_NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
TRACE_COMMONS_NEAR_AI_API_KEY=${TC_NEAR_AI_API_KEY}
TRACE_COMMONS_NEAR_AI_TIMEOUT_SECONDS=60

# Embedder (CPU fastembed via ort)
TRACE_COMMONS_EMBEDDER_MODEL_ID=BAAI/bge-large-en-v1.5
TRACE_COMMONS_EMBEDDER_CACHE_DIR=/var/cache/trace-commons-embedder
TRACE_COMMONS_VECTOR_INDEX_ROOT=/var/lib/trace-commons-vector-index
TRACE_COMMONS_VECTOR_INDEX_DIM=1024
# Pinned rather than left to default. The default is a RELATIVE sibling of
# the novelty root (`<novelty_root>/../dedup-index`), which resolves to
# /var/lib/dedup-index -- a directory the service user cannot create,
# because /var/lib is root-owned, and could not write even if it existed,
# because ProtectSystem=strict admits only the paths named in
# ReadWritePaths. That produced a DedupVectorIndexInitFailed warning on
# every boot since 2026-07-13. The two indexes must never share a root:
# a dedup lookup against the novelty index would silently return the
# wrong neighbours.
TRACE_COMMONS_DEDUP_VECTOR_INDEX_ROOT=/var/lib/trace-commons-dedup-index

# Gate floors — pilot-launch posture.
TRACE_COMMONS_GATE_PERPLEXITY_FLOOR_MICROS=0
TRACE_COMMONS_GATE_TAIL_FRACTION_FLOOR_MICROS=0
TRACE_COMMONS_GATE_NOVELTY_FLOOR_MICROS=500000
TRACE_COMMONS_GATE_POLICY_VERSION=pilot-2026-05
TRACE_COMMONS_GATE_TOP_K=5

# Credits stay zero during calibration.
TRACE_COMMONS_NOVELTY_UTILITY_CREDIT_POINTS_DELTA=0

# Pilot submission posture: accept medium residual-risk traces after
# server-side re-scrub so message-text/tool-payload pilot contributions do not
# all sit in manual quarantine. High residual-risk secret-like traces still
# quarantine.
TRACE_COMMONS_ACCEPT_MEDIUM_RISK_SUBMISSIONS=true

# Public community snapshot surface for tracecommons.ai.
TRACE_COMMONS_COMMUNITY_LEADERBOARD_ENABLED=true
TRACE_COMMONS_COMMUNITY_TENANT_IDS=${TC_TENANT_ID}
TRACE_COMMONS_COMMUNITY_CORS_ORIGINS=https://${TC_PUBLIC_HOST},http://localhost:8788,http://127.0.0.1:8788

# Logging
RUST_LOG=info,h2=warn,hyper=warn,reqwest=warn,rustls=warn

# Object store mode (separate dimension from remote-store provider).
TRACE_COMMONS_OBJECT_STORE=remote_service
TRACE_COMMONS_ARTIFACT_KEY_HEX=${TC_ARTIFACT_KEY_HEX}
TRACE_COMMONS_REMOTE_OBJECT_STORE_CREDENTIAL_REF=${TC_RUNTIME_SA}
TRACE_COMMONS_REMOTE_OBJECT_STORE_REGION=${TC_GCP_REGION}

# Enable DB writes (this is what triggers connect_from_config -> run_migrations).
TRACE_COMMONS_DB_DUAL_WRITE=true

# Object-primary submit/review mode (required when OBJECT_STORE=remote_service).
# The cascading dependencies below are checked at startup; do not remove
# entries piecemeal or the binary will refuse to start.
TRACE_COMMONS_OBJECT_PRIMARY_SUBMIT_REVIEW=true
TRACE_COMMONS_OBJECT_PRIMARY_REPLAY_EXPORT=true
TRACE_COMMONS_OBJECT_PRIMARY_DERIVED_EXPORTS=true
TRACE_COMMONS_REQUIRE_DB_MIRROR_WRITES=true
TRACE_COMMONS_DB_REVIEWER_READS=true
TRACE_COMMONS_DB_CONTRIBUTOR_READS=true
TRACE_COMMONS_DB_AUDIT_READS=true
TRACE_COMMONS_DB_REPLAY_EXPORT_READS=true
TRACE_COMMONS_DB_TENANT_POLICY_READS=true
TRACE_COMMONS_DB_REVIEWER_REQUIRE_OBJECT_REFS=true
TRACE_COMMONS_DB_REPLAY_EXPORT_REQUIRE_OBJECT_REFS=true
TRACE_COMMONS_DERIVED_EXPORT_REQUIRE_OBJECT_REFS=true
TRACE_COMMONS_REQUIRE_EXPORT_GUARDRAILS=true
TRACE_COMMONS_DB_CONTRIBUTOR_REQUIRE_OBJECT_REFS=true
TRACE_COMMONS_DB_AUDIT_REQUIRE_OBJECT_REFS=true

# Data dir must live under a path the systemd unit grants ReadWritePaths to.
TRACE_COMMONS_DATA_DIR=/var/lib/trace-commons-data

# --- Contributor accounts (Slices 1-3b) -------------------------------------
# Durable pseudonymous accounts, passkeys, login-with-NEAR, and credit
# consolidation. See docs/operator/login-resolver-role.md,
# docs/operator/account-merge.md, docs/operator/settlement-mode.md.

# Narrow login-resolver pool (REQUIRED). Migration V30 creates the
# trace_login_resolver NOLOGIN role; provision a LOGIN member
# (tc_login_resolver_login) per login-resolver-role.md and point this at it.
# If UNSET, every device-link / passkey / NEAR login redeem fails closed (400)
# and no browser session ever resolves.
TRACE_COMMONS_LOGIN_RESOLVER_DATABASE_URL=postgres://tc_login_resolver_login:${TC_LOGIN_RESOLVER_PASSWORD}@127.0.0.1:5432/trace-commons

# Passkeys (WebAuthn). All three REQUIRED together to enable passkey enroll/login;
# partial config disables passkeys (fail-closed, with a startup warning). RP_ID
# must be a registrable-domain suffix of RP_ORIGIN, and RP_ORIGIN must be the
# browser origin that serves the account login UI (adjust if that is not the
# ingest host).
TRACE_COMMONS_WEBAUTHN_RP_ID=${TC_PUBLIC_HOST}
TRACE_COMMONS_WEBAUTHN_RP_ORIGIN=https://${TC_PUBLIC_HOST}
TRACE_COMMONS_WEBAUTHN_RP_NAME=TraceCommons

# Login-with-NEAR (NEP-413). OPTIONAL — all three REQUIRED together to enable;
# leave unset to disable NEAR login (startup warns on partial config). The RPC is
# used ONLY at enroll (login verifies offline); pin a trusted endpoint. The login
# accountId is informational only and is not verified at login.
#TRACE_COMMONS_NEAR_RPC_URL=https://rpc.mainnet.near.org
#TRACE_COMMONS_NEAR_NETWORK=mainnet
#TRACE_COMMONS_NEAR_LOGIN_RECIPIENT=${TC_PUBLIC_HOST}

# NEAR credit settlement mode: disabled (default — no on-chain submission, correct
# for pre-pilot), dry_run (advances the outbox state machine with deterministic
# synthetic tx hashes, no network/funds), or http (external signing adapter; real
# in-process tx-signing is deferred to a future 3b-2). Keep disabled until a
# deployed credit contract + funded issuer key exist.
TRACE_COMMONS_NEAR_SETTLEMENT_MODE=disabled

# The three schedulers that would drive the settlement worker are also left
# unset here, and each defaults to false. Settlement is therefore off twice
# over: no scheduler ticks, and the worker would no-op if one did. This is
# deliberate -- see docs/operator/settlement-mode.md, "Current posture".
# Credit accrues as `pending` indefinitely under this configuration, and the
# submission receipt tells the contributor so.
#TRACE_COMMONS_CREDIT_SETTLEMENT_SCHEDULER_ENABLED=false
#TRACE_COMMONS_CREDIT_CYCLE_SCHEDULER_ENABLED=false
#TRACE_COMMONS_NEAR_CREDIT_OUTBOX_SCHEDULER_ENABLED=false

# --- Server-side NEAR AI PII backstop (optional, disabled by default) -------
# Async re-redaction: Low-risk traces with message_text_included are held in
# corpus status awaiting_pii_backstop instead of Accepted until the
# perplexity-scoring driver's PII-backstop pass re-scrubs and releases them.
# See docs/operator/pii-backstop.md for the enable checklist and drill.
#TRACE_COMMONS_PII_BACKSTOP_ENABLED=false
#TRACE_COMMONS_PII_BACKSTOP_TICK_INTERVAL_SECONDS=45
#TRACE_COMMONS_PII_BACKSTOP_BATCH_SIZE=5
#TRACE_COMMONS_PII_BACKSTOP_MAX_ATTEMPTS=5
#TRACE_COMMONS_PII_BACKSTOP_BACKOFF_BASE_SECONDS=30
# Cross-tenant reader pool for the trace_pii_backstop_driver role (migration
# V38). Provision a LOGIN role granted membership in trace_pii_backstop_driver
# per pii-backstop.md before setting _ENABLED=1 — fail-closed: enabled
# without this refuses at boot.
#TRACE_COMMONS_PII_BACKSTOP_DRIVER_DATABASE_URL=postgres://tc_pii_backstop_driver_login:${TC_PII_BACKSTOP_DRIVER_PASSWORD}@127.0.0.1:5432/trace-commons
# NEAR AI Cloud privacy-filter credentials used by the backstop's re-redaction
# pass. Fail-closed: enabled without the key refuses at boot.
#TRACE_NEAR_AI_PRIVACY_API_KEY=${TC_NEAR_AI_API_KEY}
#TRACE_NEAR_AI_PRIVACY_BASE_URL=https://cloud-api.near.ai/v1
#TRACE_NEAR_AI_PRIVACY_MODEL=openai/privacy-filter
#TRACE_NEAR_AI_PRIVACY_TIMEOUT_MS=10000

# Self-hosted privacy filter (openai/privacy-filter on loopback).
#
# Preferred over the near-ai backend: the hosted endpoint serves a model
# reporting context_length 512 behind an internal splitter and fails above
# ~3,000 input tokens, so that backend must window every field at a 2,000-token
# budget and stitch the spans back. Run locally the model has its real 128k
# context, one field is one request, and unredacted prose never leaves the box.
#
# Requires the trace-commons-privacy-filter service (see
# deploy/pilot-gcp/privacy-filter/). No API key: the transport is loopback.
#TRACE_PRIVACY_FILTER_BACKEND=self-hosted
#TRACE_PRIVACY_FILTER_SELF_HOSTED_BASE_URL=http://127.0.0.1:8471/v1
#TRACE_PRIVACY_FILTER_SELF_HOSTED_MODEL=openai/privacy-filter
#TRACE_PRIVACY_FILTER_SELF_HOSTED_MAX_INPUT_TOKENS=4000
#TRACE_PRIVACY_FILTER_SELF_HOSTED_TIMEOUT_MS=600000

# --- Score attestations (required for `trace-commons-contributor attest`) ---
# Without all three of these, AttestationConfig::from_env resolves to None and
# every attestation path fails closed: GET
# /.well-known/trace-commons-attestation-keyset.json and
# /v1/contributors/me/score-attestation both return
# 503 attestation_signing_key_unconfigured. That is the correct fail-closed
# behaviour, but it is indistinguishable from an outage to a contributor, so
# configure these whenever contributors are expected to attest.
#
# Generate the keypair with the binary itself (it reads no env and touches no
# database, so it works before the server is configured):
#
#   trace-commons-ingest --generate-attestation-keypair
#
# It prints all three assignments in this file's format. The private key is an
# operator secret: keep it out of version control, and prefer a separate 0640
# root:tracecommons file wired in with a systemd drop-in over pasting it here.
# The public half is published in the keyset endpoint so collectors can verify.
#TRACE_COMMONS_INGEST_ATTESTATION_SIGNING_KID=<uuid from --generate-attestation-keypair>
#TRACE_COMMONS_INGEST_ATTESTATION_SIGNING_KEY_PEM='<PKCS#8 v2 Ed25519 private key PEM>'
#TRACE_COMMONS_INGEST_ATTESTATION_PUBLIC_KEY_PEM='<SPKI Ed25519 public key PEM>'
# Attestation lifetime. Optional; defaults to 24h.
#TRACE_COMMONS_INGEST_ATTESTATION_TTL_SECONDS=86400

# Which events the NEAR AI privacy classifier examines.
#   all-events  every event (default; today's behaviour)
#   prose-only  contributor/model prose only -- roughly 10x fewer round trips.
#               Tool output relies on the deterministic detectors, which run
#               over everything regardless. Unpatterned PII arriving through
#               tool output is not model-examined under this policy.
# Unset or unrecognised values fall back to all-events.
TRACE_COMMONS_PII_CLASSIFY_POLICY=all-events
