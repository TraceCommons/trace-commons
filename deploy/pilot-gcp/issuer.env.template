# trace-commons-upload-claim-issuer pilot config template
#
# Render before staging on the host (e.g. via envsubst), then install as
# /etc/tracecommons/issuer.env (mode 0640 root:tracecommons).
#
# Placeholders:
#   ${TC_PUBLIC_HOST}                e.g. 34-41-15-28.nip.io
#   ${TC_ISSUER_SIGNING_KID}         UUID kid for the issuer's signing key
#   ${TC_DB_PASSWORD}                Cloud SQL app-role password
#
# Keys (referenced by absolute path) are staged separately under
# /etc/tracecommons/ with mode 0640 root:tracecommons and listed here only
# by path, never inline.

TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_BIND=127.0.0.1:3917
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_SIGNING_PRIVATE_KEY_FILE=/etc/tracecommons/issuer-signing-v1.pem
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_SIGNING_PUBLIC_KEY_FILE=/etc/tracecommons/issuer-signing.pub
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_SIGNING_KID=${TC_ISSUER_SIGNING_KID}
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_ISSUER=https://issuer.${TC_PUBLIC_HOST}
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_AUDIENCE=trace-commons-ingest

# Workload-token verification (operator-signed JWT bearer)
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_WORKLOAD_PUBLIC_KEY_FILE=/etc/tracecommons/workload-signing.pub
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_WORKLOAD_ISSUER=pilot-workload-issuer
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_WORKLOAD_AUDIENCE=trace-claim-issuer

# Pilot allowlist — sha256 of invite codes the workload-token bearer must
# present; the file is mode 0640 root:tracecommons and refreshed on disk.
TRACE_COMMONS_ALLOWLIST_SOURCE=file:/etc/tracecommons/allowlist.json
TRACE_COMMONS_ALLOWLIST_REFRESH_INTERVAL_SECONDS=60
TRACE_COMMONS_ALLOWLIST_MAX_STALE_SECONDS=3600

# Agent-driven onboarding — connects to the same Cloud SQL Auth Proxy
# sidecar as ingest and registers one device key per consumed invite.
DATABASE_URL=postgres://app:${TC_DB_PASSWORD}@127.0.0.1:5432/trace-commons
TRACE_COMMONS_ONBOARDING_DEVICE_KEY_REGISTRY_ENABLED=true
TRACE_COMMONS_ONBOARDING_INGEST_URL=https://ingest.${TC_PUBLIC_HOST}
TRACE_COMMONS_ONBOARDING_COMMUNITY_URL=https://${TC_PUBLIC_HOST}
TRACE_COMMONS_ONBOARDING_PROFILE_URL=https://${TC_PUBLIC_HOST}/profile
TRACE_COMMONS_ONBOARDING_LEADERBOARD_URL=https://${TC_PUBLIC_HOST}/leaderboard

# Admin endpoint stays loopback-only.
TRACE_COMMONS_ISSUER_ADMIN_BIND=127.0.0.1:8081

RUST_LOG=info,trace_commons_upload_claim_issuer=info,trace_commons_server=info
