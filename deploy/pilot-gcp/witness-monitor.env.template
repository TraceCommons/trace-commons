# /etc/tracecommons/witness-monitor.env  (mode 0640, root:tracecommons)
# Runbook: docs/operator/witness-monitor.md

# Required. The witness's public diagnostics page. Never printed or stored.
TRACE_COMMONS_WITNESS_MONITOR_URL=https://<witness-host>/v1/diagnostics

# Optional; the defaults are shown.
#TRACE_COMMONS_WITNESS_MONITOR_TIMEOUT_SECS=10
#TRACE_COMMONS_WITNESS_MONITOR_SATURATED_DELTA=1
#TRACE_COMMONS_WITNESS_MONITOR_TIMED_OUT_DELTA=1
#TRACE_COMMONS_WITNESS_MONITOR_FULL_POLLS=3
#TRACE_COMMONS_WITNESS_MONITOR_MAX_RECORDS_BYTES=10485760

# Write the Cloud Monitoring gauge each poll, as the host's service account via
# the metadata server. Set to 1 only after the IAM grant in the runbook
# ("Cloud Monitoring email alerts"); an export failure fails the unit.
#TRACE_COMMONS_WITNESS_MONITOR_EXPORT_METRICS=1
