# trace-commons-upload-claim-issuer staging config (staging design 3.4).
#
# Rendered by deploy/staging-gcp/render-env.sh to
# /etc/tracecommons/issuer.env (mode 0640 root:tracecommons). Never render it
# by hand and never commit a rendered copy.
#
# The pilot's issuer config less the invite allowlist and the community
# links: staging sign-up is open (S12) and staging has no public community
# page. The issuer still requires a workload public key to start, so one is
# configured although staging hands out no workload tokens.
#
# Placeholders (filled by render-env.sh):
#   ${TC_PUBLIC_HOST}          staging.tracecommons.ai
#   ${TC_ISSUER_SIGNING_KID}   the kid from secret tc-staging-issuer-signing-keypair
#   ${TC_DB_PASSWORD}          secret tc-staging-db-app-password
#
# The key files below are written by render-env.sh from Secret Manager,
# mode 0640 root:tracecommons, and named here only by path.

TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_BIND=127.0.0.1:3917
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_SIGNING_PRIVATE_KEY_FILE=/etc/tracecommons/issuer-signing-v1.pem
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_SIGNING_PUBLIC_KEY_FILE=/etc/tracecommons/issuer-signing.pub
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_SIGNING_KID=${TC_ISSUER_SIGNING_KID}
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_ISSUER=https://issuer.${TC_PUBLIC_HOST}
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_AUDIENCE=trace-commons-ingest

# Workload-token verification (operator-signed JWT bearer). Required to start.
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_WORKLOAD_PUBLIC_KEY_FILE=/etc/tracecommons/workload-signing.pub
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_WORKLOAD_ISSUER=staging-workload-issuer
TRACE_COMMONS_UPLOAD_CLAIM_ISSUER_WORKLOAD_AUDIENCE=trace-claim-issuer

# Device-key registration against the staging database on this VM.
DATABASE_URL=postgres://app:${TC_DB_PASSWORD}@127.0.0.1:5432/tracecommons
TRACE_COMMONS_ONBOARDING_DEVICE_KEY_REGISTRY_ENABLED=true
TRACE_COMMONS_ONBOARDING_INGEST_URL=https://ingest.${TC_PUBLIC_HOST}

# Sign-up through NEAR AI provisioning, as on the staging ingest.
TRACE_COMMONS_NEAR_PROVISIONING_ENABLED=true

# Invite lookup throttling, as on the pilot. The Caddyfile keeps
# `header_up X-Forwarded-For {remote_host}` on the issuer site, which is what
# makes the header safe to key clients by.
TRACE_COMMONS_INVITE_LOOKUP_CLIENT_IP_HEADER=X-Forwarded-For
TRACE_COMMONS_INVITE_LOOKUP_PER_CLIENT_RATE_PER_MIN=10
TRACE_COMMONS_INVITE_LOOKUP_RATE_PER_MIN=300

# Admin endpoint stays loopback-only.
TRACE_COMMONS_ISSUER_ADMIN_BIND=127.0.0.1:8081

RUST_LOG=info,trace_commons_upload_claim_issuer=info,trace_commons_server=info
