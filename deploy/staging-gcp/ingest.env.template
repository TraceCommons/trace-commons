# trace-commons-ingest staging settings (staging design 3.8, 3.12).
#
# Not rendered on its own. deploy/staging-gcp/render-env.sh renders the
# pilot's deploy/pilot-gcp/ingest.env.template with the staging values,
# then applies this file over it: each setting here replaces the pilot's line
# for the same key, and a setting left empty here (KEY=) removes the pilot's
# line. Everything not named here is the pilot's, so a pilot setting added
# later reaches staging too. Comments are dropped from the rendered file.
#
# Placeholders (filled by render-env.sh, never by hand):
#   ${TC_PUBLIC_HOST}                 staging.tracecommons.ai
#   ${TC_DB_PASSWORD}                 secret tc-staging-db-app-password
#   ${TC_LOGIN_RESOLVER_PASSWORD}     secret tc-staging-db-login-resolver-password
#   ${TC_NEAR_AI_API_KEY}             secret tc-staging-nearai-inference-key
#   ${TC_NEAR_ACCOUNT_INDEX_PEPPER}   secret tc-staging-near-account-index-pepper
#   ${TC_NEAR_ACCOUNT_NAME_KEK_KEY}   secret tc-staging-near-account-name-kek-key

# Database: PostgreSQL 16 on this VM (staging design 3.2), database
# tracecommons, owned by the role app. The login-resolver LOGIN role is made
# after the first boot (deploy/staging-gcp/README.md); until it exists every
# login redeem fails closed.
DATABASE_URL=postgres://app:${TC_DB_PASSWORD}@127.0.0.1:5432/tracecommons
TRACE_COMMONS_LOGIN_RESOLVER_DATABASE_URL=postgres://tc_login_resolver_login:${TC_LOGIN_RESOLVER_PASSWORD}@127.0.0.1:5432/tracecommons

# NEAR AI: staging only. The staging ingest refuses to boot when any NEAR AI
# host it will call, configured or defaulted, is not the staging API host
# (missing_control:near_ai_staging_host_coherence). The attestation base must
# be set: unset, it defaults to the production gateway and the boot refuses.
# One exception (staging design 3.9, owner exception 2026-10-24): render-env.sh
# with TC_SCORER_PRODUCTION_HOST and TC_SCORER_MODEL replaces the scorer's
# base and model below with a NEAR AI production direct-completions host and
# adds TRACE_COMMONS_NEAR_AI_SCORER_PRODUCTION_HOST=true and the scorer's own
# production key, TRACE_COMMONS_NEAR_AI_SCORER_API_KEY. Nothing else changes.
TRACE_COMMONS_NEAR_AI_BASE_URL=https://cloud-stg-api.near.ai/v1
TRACE_COMMONS_NEAR_AI_MODEL=Qwen/Qwen3.8-27B
TRACE_COMMONS_NEAR_AI_ATTESTATION_BASE_URL=https://cloud-stg-api.near.ai/v1

# The hosted NEAR AI privacy filter, on staging. Staging runs no self-hosted
# filter and no redaction witness (staging design 1, open item 4).
TRACE_PRIVACY_FILTER_BACKEND=near-ai
TRACE_NEAR_AI_PRIVACY_API_KEY=${TC_NEAR_AI_API_KEY}
TRACE_NEAR_AI_PRIVACY_BASE_URL=https://cloud-stg-api.near.ai/v1
TRACE_NEAR_AI_PRIVACY_MODEL=openai/privacy-filter

# Open sign-up (S12, staging design 3.12): any staging NEAR AI account signs
# up, with no invite and no list. A staging build creates accounts, and
# admits their uploads, without the admission ledger, so the ledger stays off
# and no witness setting is needed. Turning the ledger on would send those
# uploads back through it. TRACE_COMMONS_REQUIRE_TENANT_ACCESS_GRANTS stays
# false (the pilot's value): uploads are admitted by the provisioned device,
# not by a grant. Never set TRACE_COMMONS_WITNESS_* here. The wallet ceremony is
# refused by a staging build whatever is set, so its _WITNESS_JSON and
# _PUBLIC_ORIGIN are not set.
#
# These settings make the /v2 NEAR AI sign-up routes ready. Today's app signs
# up through the old routes, which still need the witness JSON, so app
# sign-up stays closed until the code change in staging design section 11
# lands (deploy/staging-gcp/README.md, step 7). Never fill the gap with a
# placeholder witness.
# Optional earned upload trust is rendered only with
# TC_CLIENT_UPLOAD_TRUST_MODE=shadow|applied. It changes client daily caps;
# both admission ledgers stay off. The renderer supplies the dedicated
# TRACE_COMMONS_CLIENT_UPLOAD_TRUST_DATABASE_URL from its feature-only secret;
# DATABASE_URL remains the staging app connection. See
# docs/operator/client-upload-allowance.md.
TRACE_COMMONS_ADMISSION_ENABLED=false
TRACE_COMMONS_NEAR_PROVISIONING_ENABLED=true

# NEAR AI sign-up writes the device's contributor grant from this template
# (owner decision 2026-10-24, "Honor app consent"). The issuer reads that
# grant as the device's claim ceiling, so a trace carries the uses the person
# consented to in the app, model training included, capped here. The issuer
# env carries the same value, for accounts made before sign-up wrote grants.
# Keep the two identical. Single-quoted so systemd keeps the JSON as written.
TRACE_COMMONS_NEAR_AI_SIGNUP_POLICY_TEMPLATE='{"policy_version":"staging-near-ai-signup-v1","allowed_consent_scopes":["debugging_evaluation","benchmark_only","ranking_training","model_training","public_attribution"],"allowed_uses":["debugging","evaluation","benchmark_generation","ranking_model_training","model_training","aggregate_analytics"]}'
TRACE_COMMONS_NEAR_ACCOUNT_INDEX_PEPPER=${TC_NEAR_ACCOUNT_INDEX_PEPPER}
TRACE_COMMONS_NEAR_ACCOUNT_NAME_KEK_KEY=${TC_NEAR_ACCOUNT_NAME_KEK_KEY}
TRACE_COMMONS_NEAR_PROVISIONING_ISSUER_URL=https://issuer.${TC_PUBLIC_HOST}
TRACE_COMMONS_NEAR_PROVISIONING_AUDIENCE=trace-commons-ingest

# The NEAR AI payout rail (staging design 3.10). Off until the reseller org
# and its credential exist on NEAR AI staging; render-env.sh switches it with
# TC_NEAR_AI_PAYOUT_MODE=dry_run and the rail's other settings.
TRACE_COMMONS_NEAR_AI_PAYOUT_MODE=disabled
# With the mode dry_run or live, render-env.sh also writes these from its
# own settings and the secret tc-staging-nearai-reseller-key (an oc_
# credential). No value is committed here:
#   TRACE_COMMONS_NEAR_AI_PAYOUT_CREDENTIAL        <the reseller secret>
#   TRACE_COMMONS_NEAR_AI_PAYOUT_CREDENTIAL_ID     <TC_NEAR_AI_PAYOUT_CREDENTIAL_ID>
#   TRACE_COMMONS_NEAR_AI_PAYOUT_SENDER_ORG        <TC_NEAR_AI_PAYOUT_SENDER_ORG>
#   TRACE_COMMONS_NEAR_AI_PAYOUT_SOURCE            <payment, grant or staking_farm>
#   TRACE_COMMONS_NEAR_AI_PAYOUT_ACCOUNT_CEILING_NANO <TC_NEAR_AI_PAYOUT_ACCOUNT_CEILING_NANO>
#   TRACE_COMMONS_CREDIT_SETTLEMENT_TABLE_PATH     <TC_CREDIT_SETTLEMENT_TABLE_PATH>
# With the mode live, it also writes the operator's halt and resume token
# from the secret tc-staging-payout-control-token; dry_run has none:
#   TRACE_COMMONS_PAYOUT_CONTROL_TOKEN             <the control token secret>
# An enabled rail also needs the sign-up settings above (provisioning on, the
# account-index pepper and the account-name KEK): the link routes seal each
# recipient under them, and the ingest refuses to boot without them.

# Referral rewards (docs/superpowers/specs/2026-10-29-referral-rewards-design.md).
# Off: with no program start nothing can be made or applied, and the bonus
# stream is disabled. Unset settings read as off; a present but malformed
# one refuses boot. Grant trace_referral_resolver to the ingest login before
# turning either on (docs/operator/referral-resolver-role.md).
TRACE_COMMONS_NEAR_AI_REFERRAL_MODE=disabled
# render-env.sh writes these only when given (TC_REFERRAL_PROGRAM_START,
# TC_NEAR_AI_REFERRAL_MODE and the rest). No value is committed here:
#   TRACE_COMMONS_REFERRAL_PROGRAM_START           <RFC 3339; unset = not started>
#   TRACE_COMMONS_REFERRAL_PROGRAM_END             <optional RFC 3339>
#   TRACE_COMMONS_REFERRAL_LATE_DAYS               <optional; default 30>
#   TRACE_COMMONS_REFERRAL_EARN_DAYS               <optional; default 92, never lower>
#   TRACE_COMMONS_REFERRAL_BONUS_BPS               <optional; default 1000>
#   TRACE_COMMONS_REFERRAL_ACCOUNT_CEILING_NANO    <optional, stream on>
# With the program started or the stream on, from the secret
# tc-staging-referral-network-mark-key:
#   TRACE_COMMONS_REFERRAL_NETWORK_MARK_KEY        <the mark key secret>
# With the stream live it sends with the payout credential: one lifetime
# budget and one send window for both streams. Only for a dedicated referral
# credential, from TC_NEAR_AI_REFERRAL_CREDENTIAL_ID and the secret
# tc-staging-nearai-referral-key:
#   TRACE_COMMONS_NEAR_AI_REFERRAL_CREDENTIAL      <the referral org credential>
#   TRACE_COMMONS_NEAR_AI_REFERRAL_CREDENTIAL_ID   <TC_NEAR_AI_REFERRAL_CREDENTIAL_ID>

# The first run's dollar estimate per accepted trace (optional). Not set in
# this file, so no value is committed: render-env.sh writes
# TRACE_COMMONS_FIRST_RUN_USD_ESTIMATE_MICROS_MIN and _MAX from
# TC_FIRST_RUN_USD_ESTIMATE_MICROS_MIN and _MAX when both are given at render
# time. Unset, the app words its first run in points.
#TRACE_COMMONS_FIRST_RUN_USD_ESTIMATE_MICROS_MIN=<from render-env.sh>
#TRACE_COMMONS_FIRST_RUN_USD_ESTIMATE_MICROS_MAX=<from render-env.sh>

# The gate policy label recorded with each decision: the pilot's floors,
# under a staging name so no staging decision reads as a pilot one.
TRACE_COMMONS_GATE_POLICY_VERSION=staging-2026-10

# No public community page on staging.
TRACE_COMMONS_COMMUNITY_LEADERBOARD_ENABLED=false
TRACE_COMMONS_COMMUNITY_TENANT_IDS=
TRACE_COMMONS_COMMUNITY_CORS_ORIGINS=
