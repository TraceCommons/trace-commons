# trace-commons-ingest staging settings (staging design 3.8, 3.12).
#
# Not rendered on its own. deploy/staging-gcp/render-env.sh renders the
# pilot's deploy/pilot-gcp/ingest.env.template with the staging values,
# then applies this file over it: each setting here replaces the pilot's line
# for the same key, and a setting left empty here (KEY=) removes the pilot's
# line. Everything not named here is the pilot's, so a pilot setting added
# later reaches staging too. Comments are dropped from the rendered file.
#
# Placeholders (filled by render-env.sh, never by hand):
#   ${TC_PUBLIC_HOST}                 staging.tracecommons.ai
#   ${TC_DB_PASSWORD}                 secret tc-staging-db-app-password
#   ${TC_LOGIN_RESOLVER_PASSWORD}     secret tc-staging-db-login-resolver-password
#   ${TC_NEAR_AI_API_KEY}             secret tc-staging-nearai-inference-key
#   ${TC_NEAR_ACCOUNT_INDEX_PEPPER}   secret tc-staging-near-account-index-pepper
#   ${TC_NEAR_ACCOUNT_NAME_KEK_KEY}   secret tc-staging-near-account-name-kek-key

# Database: PostgreSQL 16 on this VM (staging design 3.2), database
# tracecommons, owned by the role app. The login-resolver LOGIN role is made
# after the first boot (deploy/staging-gcp/README.md); until it exists every
# login redeem fails closed.
DATABASE_URL=postgres://app:${TC_DB_PASSWORD}@127.0.0.1:5432/tracecommons
TRACE_COMMONS_LOGIN_RESOLVER_DATABASE_URL=postgres://tc_login_resolver_login:${TC_LOGIN_RESOLVER_PASSWORD}@127.0.0.1:5432/tracecommons

# Passkeys: the relying party is the staging site, and the macOS app's
# passkey origin is https://${TC_PUBLIC_HOST} (channel.rs).
TRACE_COMMONS_WEBAUTHN_RP_ORIGIN=https://${TC_PUBLIC_HOST},https://ingest.${TC_PUBLIC_HOST}
TRACE_COMMONS_WEBAUTHN_RP_NAME="Near.ai Staging"

# NEAR AI: staging only. The staging ingest refuses to boot when any NEAR AI
# host it will call, configured or defaulted, is not the staging API host
# (missing_control:near_ai_staging_host_coherence). The attestation base must
# be set: unset, it defaults to the production gateway and the boot refuses.
TRACE_COMMONS_NEAR_AI_BASE_URL=https://cloud-stg-api.near.ai/v1
TRACE_COMMONS_NEAR_AI_MODEL=Qwen/Qwen3.8-27B
TRACE_COMMONS_NEAR_AI_ATTESTATION_BASE_URL=https://cloud-stg-api.near.ai/v1

# The hosted NEAR AI privacy filter, on staging. Staging runs no self-hosted
# filter and no redaction witness (staging design 1, open item 4).
TRACE_PRIVACY_FILTER_BACKEND=near-ai
TRACE_NEAR_AI_PRIVACY_API_KEY=${TC_NEAR_AI_API_KEY}
TRACE_NEAR_AI_PRIVACY_BASE_URL=https://cloud-stg-api.near.ai/v1
TRACE_NEAR_AI_PRIVACY_MODEL=openai/privacy-filter

# Open sign-up (S12, staging design 3.12): any staging NEAR AI account signs
# up, with no invite and no list. A staging build creates accounts without
# the admission ledger, so the ledger stays off and no witness setting is
# needed. Never set TRACE_COMMONS_WITNESS_* here. The wallet ceremony is
# refused by a staging build whatever is set, so its _WITNESS_JSON and
# _PUBLIC_ORIGIN are not set.
TRACE_COMMONS_ADMISSION_ENABLED=false
TRACE_COMMONS_NEAR_PROVISIONING_ENABLED=true
TRACE_COMMONS_NEAR_ACCOUNT_INDEX_PEPPER=${TC_NEAR_ACCOUNT_INDEX_PEPPER}
TRACE_COMMONS_NEAR_ACCOUNT_NAME_KEK_KEY=${TC_NEAR_ACCOUNT_NAME_KEK_KEY}
TRACE_COMMONS_NEAR_PROVISIONING_ISSUER_URL=https://issuer.${TC_PUBLIC_HOST}
TRACE_COMMONS_NEAR_PROVISIONING_AUDIENCE=trace-commons-ingest

# The NEAR AI payout rail (staging design 3.10). Off until the reseller org
# and its credential exist on NEAR AI staging; render-env.sh switches it with
# TC_NEAR_AI_PAYOUT_MODE=dry_run and the rail's other settings.
TRACE_COMMONS_NEAR_AI_PAYOUT_MODE=disabled

# The gate policy label recorded with each decision: the pilot's floors,
# under a staging name so no staging decision reads as a pilot one.
TRACE_COMMONS_GATE_POLICY_VERSION=staging-2026-10

# No public community page on staging.
TRACE_COMMONS_COMMUNITY_LEADERBOARD_ENABLED=false
TRACE_COMMONS_COMMUNITY_TENANT_IDS=
TRACE_COMMONS_COMMUNITY_CORS_ORIGINS=
