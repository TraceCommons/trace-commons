<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>TraceCommons.Interop.Tests</AssemblyName>
    <RootNamespace>TraceCommons.Interop.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/TraceCommons.Interop/TraceCommons.Interop.csproj" />
  </ItemGroup>

  <!--
    The shared scrub-label fixture, copied next to the test assembly.

    It lives at the repository root because the GTK and macOS shells read the
    same file; this is a build-time copy of that one source, not a second
    copy to maintain. ScrubDetectorLabelsMatchTheSharedFixture fails loudly if
    it is missing rather than passing over nothing.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../../tests/fixtures/scrub-detectors/labels.json"
          Link="scrub-detector-labels.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Copy the Rust cdylib next to the test assembly so .NET's default probing
    finds it without an NATIVE_DLL_SEARCH_DIRECTORIES dance.

    TC_FFI_LIB_DIR overrides the location; it defaults to the workspace's
    debug output, which is where `cargo build -p trace-commons-contributor-ffi`
    puts it. All three platform decorations are listed because this test
    project is expected to run on a developer's macOS machine as readily as on
    the Windows CI runner — Condition keeps the missing ones from failing the
    build.
  -->
  <!--
    The routing surface's implementation source, copied next to the test
    assembly.

    NoWordingIsAuthoredInThisShell reads it and fails on any string literal
    that is not a wire value. Asserted about the source rather than about
    behaviour because a hand-written word that happened to match the Rust
    would pass every behavioural test and then survive a rename in exactly
    one of the three shells.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/RoutingTools.cs"
          Link="RoutingTools.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The witness surface's implementation sources, copied for the same reason
    and read by NoWordingIsAuthoredInTheWitnessSurface.

    Both files, not just the tools one: the surface file is where the ABI
    calls live, and a sentence hand-written beside a call is exactly as much
    of a privacy claim as one written in the branch table.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/NearAccountConnection.cs" Link="NearAccountConnection.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/AdmissionPreparation.cs" Link="AdmissionPreparation.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/WitnessTools.cs"
          Link="WitnessTools.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/WitnessSurface.cs"
          Link="WitnessSurface.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The consent surface's implementation sources, copied next to the test
    assembly and read by NoWordingIsAuthoredInTheConsentSurface.

    All three, not just the two new ones: ReadGate.cs is where the four
    sentences used to live, and the strict rule is the thing that stops one
    of them coming back beside the rule that survived.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/ConsentCopy.cs"
          Link="ConsentCopy.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/ConsentSurface.cs"
          Link="ConsentSurface.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/ReadGate.cs"
          Link="ReadGate.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The app layer's routing surface and settings view model, copied next to
    the test assembly.

    TraceCommons.App is a WinUI project and cannot be built, let alone
    referenced, on the macOS and Linux machines this suite runs on, so
    without this there is nothing anywhere that checks the half of the
    surface a contributor actually looks at. Asserted about the source for
    the same reason NoWordingIsAuthoredInThisShell is: a view that recovered
    a tone from a rendered string would pass every behavioural test here.

    TheSettingsScreenAsksForTheRowRatherThanWritingIt reads it for the same
    reason at the call site: a shell can call the shared copy from one place
    and go on hand-writing the same sentence in another, which is the state
    this row was found in.
  -->
  <!--
    The private-inference surface's implementation source and the two app-layer
    files that draw it, copied for the reason above and read by
    NoWordingIsAuthoredInThePrivateInferenceSurface and
    TheOfferIsDrawnFromTheSharedSentences.

    The offer's exposure paragraph is the sentence most at risk of being
    paraphrased into a shorter, friendlier one, and a paraphrase would pass
    every behavioural test in this file.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.Interop/PrivateInferenceSurface.cs"
          Link="PrivateInferenceSurface.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.App/MainWindow.xaml"
          Link="MainWindow.xaml.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.App/ViewModels/MainViewModel.cs"
          Link="MainViewModel.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.App/ViewModels/ContributorSettingsViewModel.cs"
          Link="ContributorSettingsViewModel.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.App/Controls/SettingsView.xaml"
          Link="SettingsView.xaml.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <!--
      The model-calls destination, which holds the switch and the line that
      says what the listener actually did. Copied beside the settings surface
      above because it is held to the same strict rule: every string in it is
      a binding or a wire value, and the sentences arrive from the Rust.
    -->
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.App/ViewModels/PrivateInferenceViewModel.cs"
          Link="PrivateInferenceViewModel.cs.txt"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)../../src/TraceCommons.App/Controls/PrivateInferenceView.xaml"
          Link="PrivateInferenceView.xaml.txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Every C# and XAML source of both shell projects, copied under
    shell-source/ next to the test assembly.

    ShellWordingTests reads the whole tree. The single-file copies above stay
    exactly as they are: those surfaces are held to the strict rule that every
    string literal in them is a wire value, and this wider copy is a second,
    weaker net over everything else. It catches a hand-written sentence in a
    file nobody thought to name. obj/ and bin/ are excluded so generated
    sources (AssemblyInfo, XAML codegen) are never scanned.

    The .txt suffix matches the convention the single-file copies use: it
    keeps a copied source from ever being mistaken for a compilable one.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../src/**/*.cs;$(MSBuildThisFileDirectory)../../src/**/*.xaml"
          Exclude="$(MSBuildThisFileDirectory)../../src/**/obj/**;$(MSBuildThisFileDirectory)../../src/**/bin/**"
          Link="shell-source/%(RecursiveDir)%(Filename)%(Extension).txt"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TcFfiLibDir Condition="'$(TC_FFI_LIB_DIR)' != ''">$(TC_FFI_LIB_DIR)</TcFfiLibDir>
    <TcFfiLibDir Condition="'$(TcFfiLibDir)' == ''">$(MSBuildThisFileDirectory)../../../target/debug</TcFfiLibDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(TcFfiLibDir)/trace_commons_contributor_ffi.dll"
          Condition="Exists('$(TcFfiLibDir)/trace_commons_contributor_ffi.dll')"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(TcFfiLibDir)/libtrace_commons_contributor_ffi.dylib"
          Condition="Exists('$(TcFfiLibDir)/libtrace_commons_contributor_ffi.dylib')"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(TcFfiLibDir)/libtrace_commons_contributor_ffi.so"
          Condition="Exists('$(TcFfiLibDir)/libtrace_commons_contributor_ffi.so')"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
