<?xml version="1.0" encoding="utf-8"?>
<!--
    The queue window, drawn to the "1a Main window / queue" frame of the design
    spec (section 5.1, Windows column).

    Where the design shows a field this app cannot yet fill, the element is
    left out rather than filled with the mockup's sample text. The mockup's
    session names, byte counts and match counts are fixtures; its labels,
    headings and disclaimers are product copy and appear here verbatim. The
    parts of the frame that are missing entirely (the health banner, the undo
    bar, the week band, the per-row actions) are missing because nothing in the
    view model can back them, and each is listed in windows/README.md as work
    of its own.

    XML comments cannot contain a double hyphen, so the prose here uses commas
    and parentheses where the C# files use dashes.
-->
<Window
    x:Class="TraceCommons.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TraceCommons.App.ViewModels"
    xmlns:controls="using:TraceCommons.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Trace Commons">

    <Grid RowDefinitions="Auto,*" Background="{ThemeResource TcWindowBackgroundBrush}">

        <Grid.Resources>
            <!--
                Queue rows are cards, not list rows, so the container gives up
                its own padding and selection chrome and contributes only the
                14px gap between cards. Everything visible belongs to the card
                inside it.
            -->
            <Style x:Key="TcQueueCardContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,14" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <!--
            Title bar: 34px of chrome holding the 16px mark and the app name.

            The window extends its content into the title bar and hands this
            grid over as the drag region (see MainWindow.xaml.cs), which is the
            supported way to put a mark in a WinUI title bar. The minimise,
            maximise and close cells the spec draws are left to the system
            rather than redrawn here: real caption buttons carry snap layouts,
            the window menu and the platform's own accessibility behaviour,
            and three XAML cells that only look like them carry none of it.
            The right-hand padding is the space they occupy.
        -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="34"
              Padding="12,0,144,0"
              ColumnDefinitions="Auto,Auto"
              Background="{ThemeResource TcChromeBackgroundBrush}">
            <controls:BrandMark Grid.Column="0"
                                Size="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Trace Commons"
                       Style="{StaticResource TcChromeTitleTextStyle}"
                       VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="184,*">

            <!--
                Nav rail.

                One destination, because the app has one. The spec's History
                and Settings rows are deliberately absent rather than drawn
                disabled: a rail is a promise about where the app can go, and
                two rows that lead nowhere would be the window's first
                untrue statement. They belong here when those views do.
            -->
            <Border Grid.Column="0"
                    Padding="8,10"
                    Background="{ThemeResource TcChromeBackgroundBrush}">
                <Grid VerticalAlignment="Top">
                    <Border Background="{ThemeResource TcSurfaceScrimBrush}"
                            CornerRadius="{StaticResource TcControlCornerRadius}"
                            Padding="10,7">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- The monitor glyph from the spec's nav
                                 inventory, on its own 16-unit grid. The spec
                                 gives the geometry but not a stroke width for
                                 nav glyphs; 1.5 matches the other 16-unit
                                 icons it does specify. -->
                            <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Rectangle Canvas.Left="2" Canvas.Top="3.5"
                                               Width="12" Height="9.5"
                                               RadiusX="1.5" RadiusY="1.5"
                                               Stroke="{ThemeResource TcGreenTextBrush}"
                                               StrokeThickness="1.5" />
                                    <Path Data="M2 9h3l1.5 2h3L11 9h3"
                                          Stroke="{ThemeResource TcGreenTextBrush}"
                                          StrokeThickness="1.5" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Waiting"
                                       Style="{StaticResource TcNavLabelSelectedTextStyle}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- The selection bar: 3px, inset 8px top and bottom. -->
                    <Rectangle Width="3"
                               HorizontalAlignment="Left"
                               Margin="0,8,0,8"
                               RadiusX="2" RadiusY="2"
                               Fill="{ThemeResource TcGreenFillBrush}" />
                </Grid>
            </Border>

            <!-- Header, queue, recovery bar, decision notice, caveat, progress. -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

                <!--
                    Content header.

                    The subtitle is the app's central promise, so it is the one
                    thing on this row that may never be cut. It wraps rather
                    than clips, and everything beside it gives way first.

                    That needs the pill to sit in an elastic column rather than
                    an Auto one. An Auto column asks a child how wide it wants
                    to be and grants it, so a capped, trimming pill still takes
                    its whole cap and squeezes the sentence out; the trimming
                    never engages because nothing ever constrains it. Two star
                    columns at 2:1 make the split proportional instead, so the
                    sentence gets the larger share at every width, the pill
                    trims into what is left (its tooltip carries the full text,
                    so nothing is lost), and the row grows taller rather than
                    clipping if even that is not enough.

                    A MinWidth on the text stack is the wrong instrument and
                    was tried first: it does not reserve space, it lets the
                    stack overflow its column and be painted over, which is the
                    same clipped sentence by a different route.
                -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="2*,*,Auto"
                      ColumnSpacing="12"
                      Padding="20,9"
                      BorderBrush="{ThemeResource TcHairlineDividerBrush}"
                      BorderThickness="0,0,0,1">
                    <StackPanel Grid.Column="0"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="Waiting" Style="{StaticResource TcTitleScreenTextStyle}" />
                        <TextBlock Text="Nothing is sent unless you say so."
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!--
                        The spec's Watching chip states that the watcher is
                        running. This app cannot assert that on its own, so the
                        chip carries the daemon's own status line instead: the
                        same fact, sourced rather than claimed. It drops the eye
                        glyph, which would assert it again in a second voice.
                        The Pause split-button beside it in the design is
                        omitted: nothing in the view model can pause anything.
                    -->
                    <Border Grid.Column="1"
                            BorderBrush="{ThemeResource TcHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TcPillCornerRadius}"
                            Padding="8,2"
                            MaxWidth="200"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   Style="{StaticResource TcMonoChipTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <!-- The Refresh button keeps an Auto column: it is a
                         control with a fixed label, and a squeezed button with
                         an ellipsised caption is not a thing worth having.

                         Events drive refreshes on their own; the button is for
                         the case where a contributor wants to confirm the view
                         is current, which is a reasonable thing to want from
                         something that uploads on their behalf. -->
                    <Button Grid.Column="2"
                            Style="{StaticResource TcSecondaryButtonStyle}"
                            Click="OnRefreshClick"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Refresh the queue">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- The queue, one session card per waiting session. -->
                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Pending, Mode=OneWay}"
                          ItemContainerStyle="{StaticResource TcQueueCardContainerStyle}"
                          SelectionMode="None"
                          Padding="22,18,22,22"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueEntryViewModel">
                            <!--
                                The manifest strip bleeds to the card's inside
                                edge. Its bottom corners are rounded to 7
                                rather than relying on the card clipping it:
                                the card is a 1px border, so the inside edge
                                is one pixel tighter than the outside.
                            -->
                            <Border Background="{ThemeResource TcSurfaceCardBrush}"
                                    BorderBrush="{ThemeResource TcHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource TcCardCornerRadius}">
                                <StackPanel>
                                    <!-- Header row: name, agent, then the time
                                         pushed to the far edge. -->
                                    <Grid Padding="16,12"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <!-- A horizontal StackPanel would measure
                                             both of these against infinite
                                             width, so neither would ever trim
                                             and both would clip at the card
                                             edge instead. A Grid gives the name
                                             the elastic column and the agent a
                                             bounded one, so a long project name
                                             ellipsises rather than losing the
                                             agent beside it. -->
                                        <Grid Grid.Column="0"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind ProjectLabel}"
                                                       Style="{StaticResource TcTitleCardTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Source}"
                                                       Style="{StaticResource TcCaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="160"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind DiscoveredText}"
                                                   Style="{StaticResource TcCaptionTextStyle}"
                                                   Foreground="{ThemeResource TcInkTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!--
                                        Manifest strip. The design carries four
                                        things here; two of them have a source.

                                        The size is labelled "Session on disk",
                                        which is the label the macOS client
                                        already uses for this exact figure, and
                                        deliberately NOT the design's "Would
                                        send". A queue entry's size_bytes is
                                        the session file on disk; what would be
                                        sent is a different, usually larger
                                        number that only a preview computes,
                                        and this app does not open previews
                                        yet. Labelling one as the other would
                                        be the app's first false statement
                                        about what leaves the machine.

                                        The design's "Removed by pattern"
                                        counts and its per-card scrubbing
                                        caption are absent because the daemon
                                        does not send per-entry redaction
                                        counts here. The caveat below the queue
                                        is the part of that copy this app can
                                        stand behind.
                                    -->
                                    <Border Background="{ThemeResource TcSurfaceInsetBrush}"
                                            BorderBrush="{ThemeResource TcHairlineBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="{StaticResource TcCardInnerBottomCornerRadius}"
                                            Padding="16,10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="24">
                                                <!-- Both eyebrows override the style's ink.tertiary
                                                     foreground. They sit on the inset strip rather
                                                     than on the card, where ink.tertiary measures
                                                     4.36:1 light and 4.05:1 dark, under the 4.5:1
                                                     floor; ink.secondary clears it at 5.48 and 5.94.
                                                     This is the rule the theme dictionary states for
                                                     small type on an inset surface. -->
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="SESSION ON DISK"
                                                               Style="{StaticResource TcEyebrowTextStyle}"
                                                               Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind SizeText}"
                                                               Style="{StaticResource TcMonoFigureTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="STATUS"
                                                               Style="{StaticResource TcEyebrowTextStyle}"
                                                               Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind State}"
                                                               Style="{StaticResource TcMonoFigureTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Shown only when the daemon gave
                                                 a reason, so a healthy row
                                                 stays quiet. -->
                                            <TextBlock Text="{x:Bind ReasonLabel}"
                                                       Visibility="{x:Bind HasReason}"
                                                       Style="{StaticResource TcCaptionTextStyle}"
                                                       TextWrapping="Wrap" />

                                            <!-- Likewise retries: noise on a
                                                 row that is not retrying.

                                                 Foreground overridden off
                                                 ink.tertiary: the corrected
                                                 dark tertiary still measures
                                                 only 4.05:1 against
                                                 surface.inset, so small type
                                                 inside a manifest strip stays
                                                 on ink.secondary. -->
                                            <TextBlock Text="{x:Bind AttemptsText}"
                                                       Visibility="{x:Bind HasAttempts}"
                                                       Style="{StaticResource TcCaptionSmallTextStyle}"
                                                       Foreground="{ThemeResource TcInkSecondaryBrush}" />

                                            <!--
                                                The row's two actions, and the
                                                spec is explicit that there is
                                                no third one: the row has NO
                                                Contribute button, because
                                                approving from the row is
                                                approving without looking.
                                                Contribute lives in the preview
                                                sheet and nowhere else.

                                                "Not this one" rather than
                                                "Dismiss", because dismiss and
                                                ignore are different decisions
                                                and the words must be too. Its
                                                tooltip says which one this is.
                                            -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="0,4,0,0">
                                                <!-- Tag carries the row's own
                                                     view model. The handler
                                                     reads it rather than
                                                     relying on the inherited
                                                     DataContext, because
                                                     which entry a click means
                                                     is the one thing on this
                                                     card that must never be
                                                     ambiguous. -->
                                                <Button Style="{StaticResource TcSecondaryButtonStyle}"
                                                        Content="Look inside"
                                                        Tag="{x:Bind}"
                                                        Click="OnLookInside" />
                                                <Button Style="{StaticResource TcSecondaryButtonStyle}"
                                                        Content="Not this one"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Skips this session only. This project will keep being offered."
                                                        Click="OnNotThisOne" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state, layered over the same row as the list so the
                     two cannot both take space.

                     The copy is the macOS and Linux clients' empty state, not
                     the one this window shipped with: all three say the same
                     thing, and this app's own wording ("Sessions appear here
                     after they settle") was the only one of the three that
                     did not also say nothing is sent unless you say so. -->
                <StackPanel Grid.Row="1"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Padding="32">
                    <controls:BrandMark Size="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing waiting"
                               Style="{StaticResource TcTitleCardTextStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="When a session finishes and goes quiet, it shows up here. Nothing is sent unless you say so."
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                    The scrubbing caveat, once per screen, attached to the
                    queue rather than to any row: it is a statement about the
                    mechanism, and the mechanism is a property of the list.

                    The sentence is the canonical one the macOS and Linux
                    clients both print in this exact position, not the design's
                    longer 5.1 variant. Those two clients record the reasoning
                    at length: the caveat has to be word-for-word identical
                    everywhere it appears, so that a person who has read it
                    under the list recognises it later above Contribute rather
                    than reading a second, weaker message. A third client
                    saying it differently would break precisely that.

                    It sits in a fixed band below the queue rather than at the
                    end of the scroll stack, so it is visible on an empty queue
                    and on a long one alike.
                -->
                <!--
                    The recovery bar.

                    It lives here, on the queue, rather than in the sheet that
                    approved: recovery has to be on the screen a contributor
                    lands on after deciding, not behind a window that has
                    already closed. The countdown is the daemon's own hold,
                    read off the approve response, so the bar cannot outlive
                    the reprieve it is offering or retire one that is still
                    good.

                    "Let it send" rather than "Dismiss", because what that
                    button does is let the send happen, and it should say so.
                -->
                <Border Grid.Row="2"
                        Visibility="{x:Bind ViewModel.HasUndo, Mode=OneWay}"
                        Margin="22,0,22,12"
                        Padding="14,12"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcGreenChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.UndoHeadline, Mode=OneWay}"
                                       Style="{StaticResource TcTitleCardTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="The watcher sends approved sessions on its next sweep. Undo works until the sweep starts, and says so plainly if it is already too late."
                                       Style="{StaticResource TcCaptionTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TcSecondaryButtonStyle}"
                                Content="Let it send"
                                VerticalAlignment="Center"
                                Click="OnLetItSend" />
                        <Button Grid.Column="2"
                                Style="{StaticResource TcPrimaryButtonStyle}"
                                Content="{x:Bind ViewModel.UndoButtonText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Click="OnUndo" />
                    </Grid>
                </Border>

                <!-- One fixed sentence about the last decision, for the cases
                     with no undo to offer: a hold of zero, a refusal, or a
                     recall that came too late. -->
                <TextBlock Grid.Row="3"
                           Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap"
                           Padding="22,0,22,8" />

                <TextBlock Grid.Row="4"
                           Text="Scrubbing is pattern-based. It misses things it hasn't seen before."
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap"
                           Padding="22,10,22,14" />

                <ProgressBar Grid.Row="5"
                             IsIndeterminate="True"
                             Foreground="{ThemeResource TcGreenFillBrush}"
                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
