<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TraceCommons.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TraceCommons.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Trace Commons">

    <Grid RowDefinitions="Auto,*,Auto" Padding="0">

        <!-- Header: status line plus the manual refresh.
             Events drive refreshes on their own; the button is for the case
             where a contributor wants to confirm the view is current, which is
             a reasonable thing to want from something that uploads on their
             behalf. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Padding="20,16,20,12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1">
            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Sessions awaiting review"
                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="StatusLine"
                           Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Click="OnRefreshClick"
                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh the queue">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- The queue. -->
        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Pending, Mode=OneWay}"
                  SelectionMode="Single"
                  Padding="12,8"
                  ScrollViewer.HorizontalScrollMode="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:QueueEntryViewModel">
                    <Grid ColumnDefinitions="*,Auto" Padding="8,10" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Bind ProjectLabel}"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" />

                            <!-- Source, state and size on one secondary line:
                                 the three facts that decide whether a row needs
                                 attention, without a second visual weight. -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Source}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="·"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind State}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="·"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="{x:Bind SizeText}"
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <!-- Shown only when the daemon gave a reason, so a
                                 healthy row stays quiet. -->
                            <TextBlock Text="{x:Bind ReasonLabel}"
                                       Visibility="{x:Bind HasReason}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                            <TextBlock Text="{x:Bind DiscoveredText}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{x:Bind AttemptsText}"
                                       Visibility="{x:Bind HasAttempts}"
                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state, layered over the same row as the list so the two
             cannot both take space. -->
        <StackPanel Grid.Row="1"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Padding="32">
            <FontIcon Glyph="&#xE73E;" FontSize="28"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Nothing waiting for review"
                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Sessions appear here after they settle."
                       Style="{ThemeResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <ProgressBar Grid.Row="2"
                     IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
    </Grid>
</Window>
