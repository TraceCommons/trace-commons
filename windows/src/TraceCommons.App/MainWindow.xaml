<?xml version="1.0" encoding="utf-8"?>
<!--
    The queue window, drawn to the "1a Main window / queue" frame of the design
    spec (section 5.1, Windows column).

    Where the design shows a field this app cannot yet fill, the element is
    left out rather than filled with the mockup's sample text. The mockup's
    session names, byte counts and match counts are fixtures; its labels,
    headings and disclaimers are product copy and appear here verbatim.

    The frame is now drawn in full: header, health banner, session cards with
    their manifest strip and per row actions, the recovery bar, the standing
    disclaimer and the week band. What each piece is still missing, and why,
    is recorded beside that piece rather than here.

    XML comments cannot contain a double hyphen, so the prose here uses commas
    and parentheses where the C# files use dashes.
-->
<Window
    x:Class="TraceCommons.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TraceCommons.App.ViewModels"
    xmlns:controls="using:TraceCommons.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Trace Commons">

    <Grid RowDefinitions="Auto,*" Background="{ThemeResource TcWindowBackgroundBrush}">

        <Grid.Resources>
            <!--
                The outer list is one item per project now, not one per
                session, see MainWindow.xaml's queue ListView, which binds
                Groups rather than Pending. This container gives up its own
                padding and selection chrome and contributes only the 24px
                gap between one project's block and the next; the 14px gap
                between cards inside a project is on each row's own Border
                margin, in the inner ItemsControl's DataTemplate, because
                that container is a plain ContentPresenter with no style of
                its own to carry it.
            -->
            <Style x:Key="TcQueueGroupContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,0,0,24" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>

        <!--
            Title bar: 34px of chrome holding the 16px mark and the app name.

            The window extends its content into the title bar and hands this
            grid over as the drag region (see MainWindow.xaml.cs), which is the
            supported way to put a mark in a WinUI title bar. The minimise,
            maximise and close cells the spec draws are left to the system
            rather than redrawn here: real caption buttons carry snap layouts,
            the window menu and the platform's own accessibility behaviour,
            and three XAML cells that only look like them carry none of it.
            The right-hand padding is the space they occupy.
        -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="34"
              Padding="12,0,144,0"
              ColumnDefinitions="Auto,Auto"
              Background="{ThemeResource TcChromeBackgroundBrush}">
            <controls:BrandMark Grid.Column="0"
                                Size="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="Trace Commons"
                       Style="{StaticResource TcChromeTitleTextStyle}"
                       VerticalAlignment="Center" />
        </Grid>

        <!--
            The rail spans both rows; the content column is split so the health
            banner can sit above whichever pane is showing. See the banner
            itself for why it lives here rather than inside the queue.
        -->
        <Grid Grid.Row="1" ColumnDefinitions="184,*" RowDefinitions="Auto,Auto,*">

            <!--
                Nav rail.

                Three destinations now that there are three views. Settings
                carries only the public profile panel so far; the rest of what
                the spec puts on that screen is absent from the screen rather
                than drawn disabled, for the same reason the row itself was
                absent until now. A rail is a promise about where the app can
                go, and a row that leads nowhere would be the window's first
                untrue statement.

                Each row is a Button with its chrome removed rather than a
                Border with a tapped handler. The rail is the app's primary
                navigation, and a Button is what carries keyboard focus, the
                invoke pattern and a narrator announcement for free; a Border
                that merely looks like one carries none of it.
            -->
            <Border Grid.Column="0"
                    Grid.RowSpan="2"
                    Padding="8,10"
                    Background="{ThemeResource TcChromeBackgroundBrush}">
                <StackPanel VerticalAlignment="Top" Spacing="4">

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="OnShowQueue">
                        <Grid>
                            <Border Visibility="{x:Bind ViewModel.ShowingQueue, Mode=OneWay}"
                                    Background="{ThemeResource TcSurfaceScrimBrush}"
                                    CornerRadius="{StaticResource TcControlCornerRadius}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,7">
                                <!-- The monitor glyph from the spec's nav
                                     inventory, on its own 16-unit grid. The
                                     spec gives the geometry but not a stroke
                                     width for nav glyphs; 1.5 matches the
                                     other 16-unit icons it does specify. -->
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Rectangle Canvas.Left="2" Canvas.Top="3.5"
                                                   Width="12" Height="9.5"
                                                   RadiusX="1.5" RadiusY="1.5"
                                                   Stroke="{ThemeResource TcGreenTextBrush}"
                                                   StrokeThickness="1.5" />
                                        <Path Data="M2 9h3l1.5 2h3L11 9h3"
                                              Stroke="{ThemeResource TcGreenTextBrush}"
                                              StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Waiting"
                                           Style="{StaticResource TcNavLabelTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- The selection bar: 3px, inset 8px top and bottom. -->
                            <Rectangle Visibility="{x:Bind ViewModel.ShowingQueue, Mode=OneWay}"
                                       Width="3"
                                       HorizontalAlignment="Left"
                                       Margin="0,8,0,8"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{ThemeResource TcGreenFillBrush}" />
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="OnShowHistory">
                        <Grid>
                            <Border Visibility="{x:Bind ViewModel.ShowingHistory, Mode=OneWay}"
                                    Background="{ThemeResource TcSurfaceScrimBrush}"
                                    CornerRadius="{StaticResource TcControlCornerRadius}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,7">
                                <!-- A clock face, on the same 16-unit grid as
                                     the monitor above and at the same stroke
                                     width. History is a record of what has
                                     already happened. -->
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Ellipse Canvas.Left="2" Canvas.Top="2"
                                                 Width="12" Height="12"
                                                 Stroke="{ThemeResource TcGreenTextBrush}"
                                                 StrokeThickness="1.5" />
                                        <Path Data="M8 4.8V8l2.3 1.4"
                                              Stroke="{ThemeResource TcGreenTextBrush}"
                                              StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="History"
                                           Style="{StaticResource TcNavLabelTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Rectangle Visibility="{x:Bind ViewModel.ShowingHistory, Mode=OneWay}"
                                       Width="3"
                                       HorizontalAlignment="Left"
                                       Margin="0,8,0,8"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{ThemeResource TcGreenFillBrush}" />
                        </Grid>
                    </Button>

                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Click="OnShowSettings">
                        <Grid>
                            <Border Visibility="{x:Bind ViewModel.ShowingSettings, Mode=OneWay}"
                                    Background="{ThemeResource TcSurfaceScrimBrush}"
                                    CornerRadius="{StaticResource TcControlCornerRadius}" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="10,7">
                                <!-- Sliders, on the same 16 unit grid as the
                                     two above and at the same stroke width.
                                     Settings is a set of positions rather
                                     than a moment. The knobs are filled with
                                     the rail's own ground so each one reads
                                     as sitting on its track. -->
                                <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"
                                              Stroke="{ThemeResource TcGreenTextBrush}"
                                              StrokeThickness="1.5" />
                                        <Ellipse Canvas.Left="8.5" Canvas.Top="3"
                                                 Width="3" Height="3"
                                                 Fill="{ThemeResource TcChromeBackgroundBrush}"
                                                 Stroke="{ThemeResource TcGreenTextBrush}"
                                                 StrokeThickness="1.5" />
                                        <Ellipse Canvas.Left="4" Canvas.Top="6.5"
                                                 Width="3" Height="3"
                                                 Fill="{ThemeResource TcChromeBackgroundBrush}"
                                                 Stroke="{ThemeResource TcGreenTextBrush}"
                                                 StrokeThickness="1.5" />
                                        <Ellipse Canvas.Left="9.5" Canvas.Top="10"
                                                 Width="3" Height="3"
                                                 Fill="{ThemeResource TcChromeBackgroundBrush}"
                                                 Stroke="{ThemeResource TcGreenTextBrush}"
                                                 StrokeThickness="1.5" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Settings"
                                           Style="{StaticResource TcNavLabelTextStyle}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <Rectangle Visibility="{x:Bind ViewModel.ShowingSettings, Mode=OneWay}"
                                       Width="3"
                                       HorizontalAlignment="Left"
                                       Margin="0,8,0,8"
                                       RadiusX="2" RadiusY="2"
                                       Fill="{ThemeResource TcGreenFillBrush}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!--
                The update offer.

                An InfoBar rather than a dialog: an available update is
                not an interruption, and a contributor who came here to
                approve a session should be able to finish doing that.
                IsClosable is false because the banner is already
                conditional on a real offer (see
                UpdateProtocol.ShouldOfferUpdate), and a dismissed
                banner is an update that quietly never happens.
            -->
            <InfoBar Grid.Row="1"
                    Grid.Column="1"
                     IsOpen="{x:Bind ViewModel.IsUpdateBannerVisible, Mode=OneWay}"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Update available"
                     Message="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button Content="Update and restart"
                            Style="{StaticResource TcPrimaryButtonStyle}"
                            Click="OnApplyUpdateClick"
                            IsEnabled="{x:Bind ViewModel.IsUpdateApplyEnabled, Mode=OneWay}"
                            AutomationProperties.Name="Install the update and restart Trace Commons" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!--
                The health banner.

                It sits above both panes rather than inside the queue, so a
                contributor reading History still learns that contributions
                are held up, and so it is drawn once rather than once per
                screen. The design draws it on the queue (section 5.1 item 3)
                because the queue is the only screen that frame draws; the
                Linux shell moved it above its view stack for this reason and
                records the same note, and the two shells should not disagree
                about where a blocking condition is announced.

                Its whole content is the daemon's own health label, rendered
                through TraceCommons.Interop.HealthCopy. Nothing here ranks or
                combines conditions: last_error_label carries exactly one
                label, already resolved by the daemon's precedence order, and
                a client that rebuilt that order would eventually disagree
                with the tray about what is wrong.
            -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Visibility="{x:Bind ViewModel.HasHealthBanner, Mode=OneWay}"
                    Margin="22,16,22,0"
                    Padding="14,12"
                    Background="{ThemeResource TcSurfaceCardBrush}"
                    BorderBrush="{ThemeResource TcGoldAttentionBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource TcCardCornerRadius}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <!-- The warning triangle from the spec's 1a inventory, on
                         its own 16 unit grid. It is what carries "weigh this"
                         into greyscale; the gold border is the colour half of
                         the same statement, and neither is load bearing on
                         its own. -->
                    <Viewbox Grid.Column="0"
                             Width="14" Height="14"
                             VerticalAlignment="Top"
                             Margin="0,2,0,0">
                        <Canvas Width="16" Height="16">
                            <Path Data="M8 2.2 14.6 13.4H1.4Z"
                                  Stroke="{ThemeResource TcGoldTextBrush}"
                                  StrokeThickness="1.4" />
                            <Path Data="M8 6.6v3"
                                  Stroke="{ThemeResource TcGoldTextBrush}"
                                  StrokeThickness="1.4" />
                            <Ellipse Canvas.Left="7.5" Canvas.Top="11.2"
                                     Width="1" Height="1"
                                     Fill="{ThemeResource TcGoldTextBrush}" />
                        </Canvas>
                    </Viewbox>

                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.HealthTitle, Mode=OneWay}"
                                   Style="{StaticResource TcTitleCardTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.HealthDetail, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Only the two labels the design gives an action get a
                         button. Every other condition clears on its own, and
                         a button that cannot change what it sits beside
                         teaches people that the buttons in this app do
                         nothing. -->
                    <Button Grid.Column="2"
                            Visibility="{x:Bind ViewModel.HasHealthAction, Mode=OneWay}"
                            Style="{StaticResource TcSecondaryButtonStyle}"
                            Content="{x:Bind ViewModel.HealthActionLabel, Mode=OneWay}"
                            VerticalAlignment="Center"
                            Click="OnHealthAction" />
                </Grid>
            </Border>

            <!--
                The History pane.

                It is created once and kept rather than rebuilt on each nav
                click, because it holds the per submission record of what a
                withdrawal actually did. list_history reports a record's
                status, never the tier a withdrawal resolved to, so rebuilding
                the pane would throw that away: a contributor who withdrew a
                trace, glanced at the queue and came back would find the
                sentence naming the tier the server applied replaced by a bare
                chip. That is the contract's first withdrawal rule broken by a
                navigation.
            -->
            <ContentPresenter x:Name="HistoryPane"
                              Grid.Row="2"
                              Grid.Column="1"
                              Visibility="{x:Bind ViewModel.ShowingHistory, Mode=OneWay}" />

            <!--
                The Settings pane, created once and kept for the same reason
                History is: it holds the handle and bio boxes as the
                contributor has edited them, and rebuilding it on every nav
                click would silently discard an unsaved edit. It also holds
                the sentence saying what the last claim or withdrawal actually
                did, and that sentence is the only report of an outward facing
                act this window ever gives.
            -->
            <ContentPresenter x:Name="SettingsPane"
                              Grid.Row="2"
                              Grid.Column="1"
                              Visibility="{x:Bind ViewModel.ShowingSettings, Mode=OneWay}" />

            <!-- Header, queue, recovery bar, decision notice, caveat, week
                 band, progress. -->
            <Grid Grid.Row="2"
                  Grid.Column="1"
                  Visibility="{x:Bind ViewModel.ShowingQueue, Mode=OneWay}"
                  RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

                <!--
                    Content header.

                    The subtitle is the app's central promise, so it is the one
                    thing on this row that may never be cut. It wraps rather
                    than clips, and everything beside it gives way first.

                    That needs the pill to sit in an elastic column rather than
                    an Auto one. An Auto column asks a child how wide it wants
                    to be and grants it, so a capped, trimming pill still takes
                    its whole cap and squeezes the sentence out; the trimming
                    never engages because nothing ever constrains it. Two star
                    columns at 2:1 make the split proportional instead, so the
                    sentence gets the larger share at every width, the pill
                    trims into what is left (its tooltip carries the full text,
                    so nothing is lost), and the row grows taller rather than
                    clipping if even that is not enough.

                    A MinWidth on the text stack is the wrong instrument and
                    was tried first: it does not reserve space, it lets the
                    stack overflow its column and be painted over, which is the
                    same clipped sentence by a different route.
                -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="2*,*,Auto,Auto"
                      ColumnSpacing="12"
                      Padding="20,9"
                      BorderBrush="{ThemeResource TcHairlineDividerBrush}"
                      BorderThickness="0,0,0,1">
                    <StackPanel Grid.Column="0"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="Waiting" Style="{StaticResource TcTitleScreenTextStyle}" />
                        <TextBlock Text="Nothing is sent unless you say so."
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!--
                        The spec's Watching chip states that the watcher is
                        running. This app cannot assert that on its own, so the
                        chip carries the daemon's own status line instead: the
                        same fact, sourced rather than claimed. It drops the eye
                        glyph, which would assert it again in a second voice.
                        The pause control beside it calls the daemon, so a
                        timed pause survives this process closing and resumes
                        on the same deadline every other shell uses.
                    -->
                    <Border Grid.Column="1"
                            BorderBrush="{ThemeResource TcHairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource TcPillCornerRadius}"
                            Padding="8,2"
                            MaxWidth="200"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   Style="{StaticResource TcMonoChipTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <Button Grid.Column="2"
                            Style="{StaticResource TcSecondaryButtonStyle}"
                            Content="Pause"
                            Visibility="{x:Bind ViewModel.IsWatching, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Pause watching">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="For 1 hour" Click="OnPauseForHour" />
                                <MenuFlyoutItem Text="Until tomorrow morning"
                                                Click="OnPauseUntilTomorrow" />
                                <MenuFlyoutItem Text="Until I turn it back on"
                                                Click="OnPauseUntilResumed" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource TcSecondaryButtonStyle}"
                            Content="Resume watching"
                            Visibility="{x:Bind ViewModel.IsPaused, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            Click="OnResumeWatching"
                            VerticalAlignment="Center" />

                    <!-- The Refresh button keeps an Auto column: it is a
                         control with a fixed label, and a squeezed button with
                         an ellipsised caption is not a thing worth having.

                         Events drive refreshes on their own; the button is for
                         the case where a contributor wants to confirm the view
                         is current, which is a reasonable thing to want from
                         something that uploads on their behalf. -->
                    <Button Grid.Column="3"
                            Style="{StaticResource TcSecondaryButtonStyle}"
                            Click="OnRefreshClick"
                            IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Refresh the queue">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="12" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </Grid>


                <!--
                    The queue, grouped by project. The grouping RULE, which
                    entries share a group, group order, whether a group's
                    "Submit all" appears, is QueueGrouping.ByProject's, in
                    TraceCommons.Interop, and is covered by
                    QueueGroupingTests there; this outer ListView (one item
                    per project) and the inner ItemsControl (one item per
                    session within it) only render what that already decided.
                -->
                <ListView Grid.Row="2"
                          ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
                          ItemContainerStyle="{StaticResource TcQueueGroupContainerStyle}"
                          SelectionMode="None"
                          Padding="22,18,22,22"
                          ScrollViewer.HorizontalScrollMode="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueGroupViewModel">
                            <StackPanel Spacing="12">
                                <!--
                                    The group header: project label, entry
                                    count, and, only for a project with more
                                    than one entry, see
                                    QueueGroupViewModel.ShowSubmitAll, the
                                    "Submit all" action. A single-entry group
                                    offers no second way to do what its one
                                    row's own Submit already does.
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                        <TextBlock Text="{x:Bind ProjectLabel}"
                                                   Style="{StaticResource TcTitleCardTextStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind CountText}"
                                                   Style="{StaticResource TcCaptionTextStyle}"
                                                   Foreground="{ThemeResource TcInkSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Style="{StaticResource TcPrimaryButtonStyle}"
                                            Content="{x:Bind SubmitAllText}"
                                            Visibility="{x:Bind ShowSubmitAll}"
                                            Tag="{x:Bind}"
                                            ToolTipService.ToolTip="Sends every session waiting in this project, in one call. Scrubbing still runs, and Undo follows for a few seconds."
                                            Click="OnSubmitAll" />
                                </Grid>

                                <!--
                                    The rows, unchanged from a plain queue:
                                    this ItemsControl carries no selection and
                                    no virtualization concerns beyond what a
                                    small per-project list already has, and
                                    every decision each row's own buttons make
                                    is exactly as it was when the outer list
                                    was flat.
                                -->
                                <ItemsControl ItemsSource="{x:Bind Entries}">
                                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueEntryViewModel">
                            <!--
                                The manifest strip bleeds to the card's inside
                                edge. Its bottom corners are rounded to 7
                                rather than relying on the card clipping it:
                                the card is a 1px border, so the inside edge
                                is one pixel tighter than the outside.
                            -->
                            <Border Background="{ThemeResource TcSurfaceCardBrush}"
                                    BorderBrush="{ThemeResource TcHairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource TcCardCornerRadius}"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <!-- Header row: name, agent, then the time
                                         pushed to the far edge. -->
                                    <Grid Padding="16,12"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="12">
                                        <!-- A horizontal StackPanel would measure
                                             both of these against infinite
                                             width, so neither would ever trim
                                             and both would clip at the card
                                             edge instead. A Grid gives the name
                                             the elastic column and the agent a
                                             bounded one, so a long project name
                                             ellipsises rather than losing the
                                             agent beside it. -->
                                        <Grid Grid.Column="0"
                                              ColumnDefinitions="*,Auto"
                                              ColumnSpacing="8">
                                            <TextBlock Grid.Column="0"
                                                       Text="{x:Bind ProjectLabel}"
                                                       Style="{StaticResource TcTitleCardTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Source}"
                                                       Style="{StaticResource TcCaptionTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="160"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind DiscoveredText}"
                                                   Style="{StaticResource TcCaptionTextStyle}"
                                                   Foreground="{ThemeResource TcInkTertiaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <!--
                                        Manifest strip. The design carries four
                                        things here; two of them have a source.

                                        The size is labelled "Session on disk",
                                        which is the label the macOS client
                                        already uses for this exact figure, and
                                        deliberately NOT the design's "Would
                                        send". A queue entry's size_bytes is
                                        the session file on disk; what would be
                                        sent is a different, usually larger
                                        number that only a preview computes,
                                        and this app does not open previews
                                        yet. Labelling one as the other would
                                        be the app's first false statement
                                        about what leaves the machine.

                                        The design's "Removed by pattern"
                                        counts and its per-card scrubbing
                                        caption are absent because the daemon
                                        does not send per-entry redaction
                                        counts here. The caveat below the queue
                                        is the part of that copy this app can
                                        stand behind.
                                    -->
                                    <Border Background="{ThemeResource TcSurfaceInsetBrush}"
                                            BorderBrush="{ThemeResource TcHairlineBrush}"
                                            BorderThickness="0,1,0,0"
                                            CornerRadius="{StaticResource TcCardInnerBottomCornerRadius}"
                                            Padding="16,10">
                                        <StackPanel Spacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="24">
                                                <!-- Both eyebrows override the style's ink.tertiary
                                                     foreground. They sit on the inset strip rather
                                                     than on the card, where ink.tertiary measures
                                                     4.36:1 light and 4.05:1 dark, under the 4.5:1
                                                     floor; ink.secondary clears it at 5.48 and 5.94.
                                                     This is the rule the theme dictionary states for
                                                     small type on an inset surface. -->
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="SESSION ON DISK"
                                                               Style="{StaticResource TcEyebrowTextStyle}"
                                                               Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind SizeText}"
                                                               Style="{StaticResource TcMonoFigureTextStyle}" />
                                                </StackPanel>
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="STATUS"
                                                               Style="{StaticResource TcEyebrowTextStyle}"
                                                               Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                                    <TextBlock Text="{x:Bind State}"
                                                               Style="{StaticResource TcMonoFigureTextStyle}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Shown only when the daemon gave
                                                 a reason, so a healthy row
                                                 stays quiet. -->
                                            <TextBlock Text="{x:Bind ReasonLabel}"
                                                       Visibility="{x:Bind HasReason}"
                                                       Style="{StaticResource TcCaptionTextStyle}"
                                                       TextWrapping="Wrap" />

                                            <!-- Likewise retries: noise on a
                                                 row that is not retrying.

                                                 Foreground overridden off
                                                 ink.tertiary: the corrected
                                                 dark tertiary still measures
                                                 only 4.05:1 against
                                                 surface.inset, so small type
                                                 inside a manifest strip stays
                                                 on ink.secondary. -->
                                            <TextBlock Text="{x:Bind AttemptsText}"
                                                       Visibility="{x:Bind HasAttempts}"
                                                       Style="{StaticResource TcCaptionSmallTextStyle}"
                                                       Foreground="{ThemeResource TcInkSecondaryBrush}" />

                                            <!--
                                                The row's three actions.
                                                Contribute used to be reachable
                                                only from behind the preview
                                                sheet, see
                                                docs/superpowers/specs/2026-08-20-one-click-submit-design.md,
                                                "The problem", but the daemon
                                                now builds and pins an envelope
                                                for anything unpreviewed inside
                                                `approve` itself, so a row
                                                submit no longer sends bytes
                                                nobody was shown. Submit is
                                                still the one irreversible-ish
                                                click here (an undo bar follows
                                                it); it carries no keyboard
                                                accelerator, the same rule the
                                                preview sheet's Contribute
                                                follows, and every decision
                                                about what the response means
                                                is made in
                                                MainViewModel.SubmitEntryAsync
                                                and TraceCommons.Interop, not
                                                here.

                                                A submit for the WHOLE project
                                                lives on the group header this
                                                row sits under, not here: a
                                                row that could both submit
                                                itself and submit its
                                                siblings would make "Submit"
                                                ambiguous every time it was
                                                clicked. See the group header
                                                below, and
                                                QueueGroupViewModel.ShowSubmitAll.

                                                "Not this one" rather than
                                                "Dismiss", because dismiss and
                                                ignore are different decisions
                                                and the words must be too. Its
                                                tooltip says which one this is.
                                            -->
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="0,4,0,0">
                                                <!-- Tag carries the row's own
                                                     view model. The handler
                                                     reads it rather than
                                                     relying on the inherited
                                                     DataContext, because
                                                     which entry a click means
                                                     is the one thing on this
                                                     card that must never be
                                                     ambiguous. -->
                                                <Button Style="{StaticResource TcSecondaryButtonStyle}"
                                                        Content="Look inside"
                                                        Tag="{x:Bind}"
                                                        Click="OnLookInside" />
                                                <Button Style="{StaticResource TcSecondaryButtonStyle}"
                                                        Content="Not this one"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Skips this session only. This project will keep being offered."
                                                        Click="OnNotThisOne" />
                                                <Button Style="{StaticResource TcPrimaryButtonStyle}"
                                                        Content="Submit"
                                                        Tag="{x:Bind}"
                                                        ToolTipService.ToolTip="Sends this session without opening it. Scrubbing still runs, and Undo follows for a few seconds."
                                                        Click="OnSubmitEntry" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty state, layered over the same row as the list so the
                     two cannot both take space.

                     The copy is the macOS and Linux clients' empty state, not
                     the one this window shipped with: all three say the same
                     thing, and this app's own wording ("Sessions appear here
                     after they settle") was the only one of the three that
                     did not also say nothing is sent unless you say so. -->
                <StackPanel Grid.Row="2"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Padding="32">
                    <controls:BrandMark Size="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing waiting"
                               Style="{StaticResource TcTitleCardTextStyle}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="When a session finishes and goes quiet, it shows up here. Nothing is sent unless you say so."
                               Style="{StaticResource TcCaptionTextStyle}"
                               TextWrapping="Wrap"
                               MaxWidth="360"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!--
                    The scrubbing caveat, once per screen, attached to the
                    queue rather than to any row: it is a statement about the
                    mechanism, and the mechanism is a property of the list.

                    The sentence is the canonical one the macOS and Linux
                    clients both print in this exact position, not the design's
                    longer 5.1 variant. Those two clients record the reasoning
                    at length: the caveat has to be word-for-word identical
                    everywhere it appears, so that a person who has read it
                    under the list recognises it later above Contribute rather
                    than reading a second, weaker message. A third client
                    saying it differently would break precisely that.

                    It sits in a fixed band below the queue rather than at the
                    end of the scroll stack, so it is visible on an empty queue
                    and on a long one alike.
                -->
                <!--
                    The recovery bar.

                    It lives here, on the queue, rather than in the sheet that
                    approved: recovery has to be on the screen a contributor
                    lands on after deciding, not behind a window that has
                    already closed. The countdown is the daemon's own hold,
                    read off the approve response, so the bar cannot outlive
                    the reprieve it is offering or retire one that is still
                    good.

                    "Let it send" rather than "Dismiss", because what that
                    button does is let the send happen, and it should say so.
                -->
                <Border Grid.Row="2"
                        Visibility="{x:Bind ViewModel.HasUndo, Mode=OneWay}"
                        Margin="22,0,22,12"
                        Padding="14,12"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcGreenChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.UndoHeadline, Mode=OneWay}"
                                       Style="{StaticResource TcTitleCardTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="The watcher sends approved sessions on its next sweep. Undo works until the sweep starts, and says so plainly if it is already too late."
                                       Style="{StaticResource TcCaptionTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Style="{StaticResource TcSecondaryButtonStyle}"
                                Content="Let it send"
                                VerticalAlignment="Center"
                                Click="OnLetItSend" />
                        <Button Grid.Column="2"
                                Style="{StaticResource TcPrimaryButtonStyle}"
                                Content="{x:Bind ViewModel.UndoButtonText, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Click="OnUndo" />
                    </Grid>
                </Border>

                <!-- One fixed sentence about the last decision, for the cases
                     with no undo to offer: a hold of zero, a refusal, or a
                     recall that came too late. -->
                <TextBlock Grid.Row="3"
                           Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap"
                           Padding="22,0,22,8" />

                <TextBlock Grid.Row="4"
                           Text="Scrubbing is pattern-based. It misses things it hasn't seen before."
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap"
                           Padding="22,10,22,14" />

                <!--
                    The week band, section 5.1 item 9: an eyebrow and a rule,
                    then three equal stat cards.

                    Its figures come from history_rollup, which History
                    already reads. The queue asks for it in its own refresh
                    rather than taking it from the History screen, so the band
                    is filled whether or not History has ever been opened.
                    That is one extra read of counters the daemon already
                    holds, and it is the same choice the Linux shell records
                    in App::refresh.

                    Two of the three labels are HistoryCopy's own constants
                    rather than restatements: a contributor who reads "Held
                    for privacy review" here and something else on the next
                    screen has been told two different things about one state.

                    The cards are built like History's three, not like the
                    design's: this shell's stat card carries its tone in the
                    border rather than in an icon, and one screen introducing
                    glyphs the sibling screen does not have would read as two
                    designs rather than one.
                -->
                <StackPanel Grid.Row="5" Padding="22,4,22,16" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.ThisWeekLabel}"
                                   Style="{StaticResource TcEyebrowTextStyle}"
                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                   VerticalAlignment="Center" />
                        <Rectangle Grid.Column="1"
                                   Height="1"
                                   VerticalAlignment="Center"
                                   Fill="{ThemeResource TcHairlineBrush}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                Background="{ThemeResource TcSurfaceCardBrush}"
                                BorderBrush="{ThemeResource TcHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource TcCardCornerRadius}"
                                Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.ContributedLabel}"
                                           Style="{StaticResource TcEyebrowTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.ContributedCountText, Mode=OneWay}"
                                           Style="{StaticResource TcMonoFigureTextStyle}" />
                            </StackPanel>
                        </Border>

                        <!-- Held takes the gold border, exactly as it does on
                             History. It is not a failure and is never drawn as
                             one; it is the one figure here that is waiting on
                             a person. -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource TcSurfaceCardBrush}"
                                BorderBrush="{ThemeResource TcGoldAttentionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource TcCardCornerRadius}"
                                Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.HeldLabel}"
                                           Style="{StaticResource TcEyebrowTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.HeldCountText, Mode=OneWay}"
                                           Style="{StaticResource TcMonoFigureTextStyle}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{ThemeResource TcSurfaceCardBrush}"
                                BorderBrush="{ThemeResource TcHairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource TcCardCornerRadius}"
                                Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.InTheCommonsLabel}"
                                           Style="{StaticResource TcEyebrowTextStyle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.InTheCommonsCountText, Mode=OneWay}"
                                           Style="{StaticResource TcMonoFigureTextStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <ProgressBar Grid.Row="6"
                             IsIndeterminate="True"
                             Foreground="{ThemeResource TcGreenFillBrush}"
                             Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
