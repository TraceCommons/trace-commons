<?xml version="1.0" encoding="utf-8"?>
<!--
    Stock controls re-templated to the Mac's shapes and motion (spec W5-D3 (a)),
    keeping each control's own automation peer: the switch, the spinner (a
    ProgressRing), the refresh pill (a Button) and the loading bar.

    Every colour and size is a generated token (GlassTokens.xaml). Every
    transition carries the Mac's curve and duration as key frames: the token
    curve is KeySpline 0.2,0.8 0.2,1 (GlassMotion.swift:7-11) and SwiftUI's
    ease-out is KeySpline 0,0 0.58,1. Never WinUI's own timings. Each template
    root sets GlassVisualStateManager, which skips the transitions while the
    system's animations are off or the window cannot be seen, so a control
    then goes straight to its final state.

    XML comments cannot contain a double hyphen.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:look="using:TraceCommons.App.Look">

    <!--
        The switch (Controls.swift:1110-1188, GlassToggleStyle, Settings kind):
        a 40 by 24 capsule, toggleOff or toggleOnSettings, an 18 knob inset 3,
        textOnAccent when on and toggleKnobOff when off. The knob slides 16 on
        ease-out over 0.22 s (Controls.swift:1145-1147, :1167), and the track
        and knob colours change on the same curve. Pressed, the track darkens
        by a 0.08 black wash over 0.15 s on the token curve (GlassPress.swift).
        Disabled, 0.45 opacity (Opacity.disabled).

        The parts the stock ToggleSwitch looks for are kept, so a drag still
        moves the knob: SwitchKnobBounds is the knob's travel (the track less
        its insets, 34 wide, so 34 less the 18 knob is the 16 the Mac slides),
        SwitchKnob and KnobTranslateTransform the knob, SwitchThumb the drag.
    -->
    <Style x:Key="TcGlassSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="Foreground" Value="{ThemeResource TcGlassInkBrush}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="{StaticResource TcUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TcGlassTypeBodyFontSize}" />
        <Setter Property="ManipulationMode" Value="System,TranslateX" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Background="{TemplateBinding Background}">
                        <VisualStateManager.CustomVisualStateManager>
                            <look:GlassVisualStateManager />
                        </VisualStateManager.CustomVisualStateManager>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="Pressed">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressWash" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition From="Pressed">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressWash" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="PressWash.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchArea.Opacity" Value="{StaticResource TcGlassOpacityDisabled}" />
                                        <Setter Target="HeaderContentPresenter.Opacity" Value="{StaticResource TcGlassOpacityDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="On">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="16" KeySpline="0,0 0.58,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1" KeySpline="0,0 0.58,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="1" KeySpline="0,0 0.58,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="Off">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0" KeySpline="0,0 0.58,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0" KeySpline="0,0 0.58,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.22" Value="0" KeySpline="0,0 0.58,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="0" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="16" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent">
                                    <VisualState.Setters>
                                        <Setter Target="OffContentPresenter.Opacity" Value="1" />
                                        <Setter Target="OnContentPresenter.Opacity" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="OnContent">
                                    <VisualState.Setters>
                                        <Setter Target="OffContentPresenter.Opacity" Value="0" />
                                        <Setter Target="OnContentPresenter.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <ContentPresenter x:Name="HeaderContentPresenter"
                                          Grid.Row="0"
                                          Margin="0,0,0,6"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{ThemeResource TcGlassInkBrush}"
                                          IsHitTestVisible="False"
                                          TextWrapping="Wrap"
                                          Visibility="Collapsed"
                                          x:DeferLoadStrategy="Lazy" />

                        <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="SwitchAreaGrid" Grid.ColumnSpan="3" Background="Transparent" Control.IsTemplateFocusTarget="True" />
                            <Grid x:Name="SwitchArea"
                                  Grid.Column="0"
                                  Width="{StaticResource TcGlassSizeToggleWidth}"
                                  Height="{StaticResource TcGlassSizeToggleHeight}"
                                  VerticalAlignment="Center">
                                <Border x:Name="OffTrack" CornerRadius="{StaticResource TcGlassRadiusPill}" Background="{ThemeResource TcGlassToggleOffBrush}" />
                                <Border x:Name="OnTrack" CornerRadius="{StaticResource TcGlassRadiusPill}" Background="{ThemeResource TcGlassToggleOnBrush}" Opacity="0" />
                                <Border x:Name="PressWash" CornerRadius="{StaticResource TcGlassRadiusPill}" Background="{ThemeResource TcGlassPressWashBrush}" Opacity="0" />
                                <Border x:Name="SwitchKnobBounds" Margin="3,0,3,0" />
                                <Grid x:Name="SwitchKnob" Width="18" Height="18" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="KnobTranslateTransform" />
                                    </Grid.RenderTransform>
                                    <Ellipse x:Name="KnobOff" Fill="{ThemeResource TcGlassToggleKnobOffBrush}" />
                                    <Ellipse x:Name="KnobOn" Fill="{ThemeResource TcGlassToggleKnobOnBrush}" Opacity="0" />
                                </Grid>
                                <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ContentPresenter x:Name="OffContentPresenter"
                                              Grid.Column="2"
                                              Opacity="0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding OffContent}"
                                              ContentTemplate="{TemplateBinding OffContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter x:Name="OnContentPresenter"
                                              Grid.Column="2"
                                              Opacity="0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding OnContent}"
                                              ContentTemplate="{TemplateBinding OnContentTemplate}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Every ToggleSwitch in the app takes the Mac's switch. -->
    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource TcGlassSwitchStyle}" />

    <!--
        The spinner (Feedback.swift:15-63): a ring in ink at 0.18 and a quarter
        arc in the secondary ink, both 1.5 wide; GlassSpinner shapes the arc
        and turns it.
    -->
    <Style x:Key="TcGlassSpinnerStyle" TargetType="look:GlassSpinner">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="look:GlassSpinner">
                    <Grid>
                        <Ellipse Stroke="{ThemeResource TcGlassSpinnerTrackBrush}" StrokeThickness="{StaticResource TcGlassSizeSpinnerStroke}" />
                        <Path x:Name="Arc"
                              Stroke="{ThemeResource TcGlassSpinnerArcBrush}"
                              StrokeThickness="{StaticResource TcGlassSizeSpinnerStroke}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round">
                            <Path.RenderTransform>
                                <RotateTransform />
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The loading bar (Feedback.swift:97-102): ink at 0.08 in the control radius. -->
    <Style x:Key="TcGlassSkeletonStyle" TargetType="look:GlassSkeleton">
        <Setter Property="Height" Value="{StaticResource TcGlassSizeSkeletonHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="look:GlassSkeleton">
                    <Border Background="{ThemeResource TcGlassSkeletonBrush}" CornerRadius="{StaticResource TcGlassRadiusControl}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The refresh pill (Containers.swift:150-182, GlassRefreshPill): the
        word in the label type, then the refresh glyph (SymbolGlyphs
        arrow.clockwise, U+E72C), on the control surface, as tall as the large
        round button (28) with its height for a radius. Under the pointer the
        control's hover fill fades in over 0.15 s on the token curve
        (GlassHover.swift:40); pressed, a 0.08 black wash, the same timing
        (GlassPress.swift:107-127). Disabled while refreshing, at 0.45.
    -->
    <Style x:Key="TcGlassRefreshButtonStyle" TargetType="look:GlassRefreshButton">
        <Setter Property="Height" Value="{StaticResource TcGlassSizeControlLarge}" />
        <Setter Property="Foreground" Value="{ThemeResource TcGlassInkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource TcUiFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource TcGlassTypeLabelFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="look:GlassRefreshButton">
                    <Grid x:Name="Root" CornerRadius="14" Background="{ThemeResource TcGlassControlBrush}">
                        <VisualStateManager.CustomVisualStateManager>
                            <look:GlassVisualStateManager />
                        </VisualStateManager.CustomVisualStateManager>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressWash" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="Pressed">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressWash" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="1" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="Normal">
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverFill" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PressWash" Storyboard.TargetProperty="Opacity">
                                                <SplineDoubleKeyFrame KeyTime="0:0:0.15" Value="0" KeySpline="0.2,0.8 0.2,1" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverFill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverFill.Opacity" Value="1" />
                                        <Setter Target="PressWash.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="{StaticResource TcGlassOpacityDisabled}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="HoverFill" Background="{ThemeResource TcGlassControlHoverBrush}" Opacity="0" />
                        <Border x:Name="PressWash" Background="{ThemeResource TcGlassPressWashBrush}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource TcGlassSpaceS2}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                            <FontIcon x:Name="Glyph"
                                      Glyph="&#xE72C;"
                                      FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                      FontSize="12"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"
                                      AutomationProperties.AccessibilityView="Raw">
                                <FontIcon.RenderTransform>
                                    <RotateTransform />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
