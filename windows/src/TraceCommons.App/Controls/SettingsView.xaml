<?xml version="1.0" encoding="utf-8"?>
<!--
    The complete device Settings screen, plus the public profile from section
    5.6 of the design spec.

    Every value comes from the daemon or the operating system. Timing edits
    send one set_settings key at a time, project changes use opaque project
    ids, and the local audit log contains fixed labels only.

    Two surfaces, not two states of one. Off the roster this is a single
    control that grants nothing and opens a consent dialog; on it, it is a
    panel of the fields that are actually published. The change of surface IS
    the statement about where the public boundary is, which is why the two are
    separate elements rather than one restyled into the other.

    The footnote sits OUTSIDE the panel, in the window's own type: it is this
    window talking about the public surface, not part of it.

    XML comments cannot contain a double hyphen, so the prose here uses commas
    and parentheses where the C# files use dashes.
-->
<UserControl
    x:Class="TraceCommons.App.Controls.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TraceCommons.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0"
                    Spacing="2"
                    Padding="20,9"
                    BorderBrush="{ThemeResource TcHairlineDividerBrush}"
                    BorderThickness="0,0,0,1">
            <TextBlock Text="Settings" Style="{StaticResource TcTitleScreenTextStyle}" />
            <TextBlock Text="What this machine watches, and what your traces are allowed to do."
                       Style="{StaticResource TcCaptionTextStyle}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Padding="22,16,22,16">
            <StackPanel Spacing="12" MaxWidth="640" HorizontalAlignment="Left">

                <TextBlock Text="CONNECTION"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind Settings.ConnectionText, Mode=OneWay}"
                                   Style="{StaticResource TcTitleCardTextStyle}" />
                        <TextBlock Text="{x:Bind Settings.ConnectionDetail, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.HasConnectionDetail, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{x:Bind Settings.ConnectionRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConnectionStatusViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                                        <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}"
                                                   Style="{StaticResource TcBodyDenseTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind State}"
                                                   Style="{StaticResource TcMonoChipTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="STARTUP"
                           Style="{StaticResource TcEyebrowTextStyle}"
                           Visibility="{x:Bind Settings.StartupSupported, Mode=OneWay}" />
                <ToggleSwitch Header="Start Trace Commons when you sign in"
                              IsOn="{x:Bind Settings.StartAtLogin, Mode=OneWay}"
                              IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                              Visibility="{x:Bind Settings.StartupSupported, Mode=OneWay}"
                              Toggled="OnStartAtLoginToggled" />

                <TextBlock Text="HOW MAY YOUR TRACES BE USED?"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <TextBlock Text="Applies to traces you send from now on."
                           Style="{StaticResource TcCaptionTextStyle}" />

                <TextBlock Text="ALWAYS INCLUDED"
                           Style="{StaticResource TcCaptionSmallTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.AlwaysIncluded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsentScopeViewModel">
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                      IsEnabled="False"
                                      Margin="0,2">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource TcTitleCardTextStyle}" />
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource TcCaptionTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="OPTIONAL — EACH ONE LETS YOUR TRACES DO MORE"
                           Style="{StaticResource TcCaptionSmallTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.OptionalScopes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsentScopeViewModel">
                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                      IsEnabled="{x:Bind IsEnabled}"
                                      Click="OnConsentChanged"
                                      Margin="0,2">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Title}"
                                               Style="{StaticResource TcTitleCardTextStyle}" />
                                    <TextBlock Text="{x:Bind Description}"
                                               Style="{StaticResource TcCaptionTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nothing here is pre-selected on your behalf."
                           Style="{StaticResource TcCaptionTextStyle}" />

                <TextBlock Text="HOW IT BEHAVES"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12">
                    <StackPanel Spacing="10">
                        <NumberBox x:Name="QuiescenceMinutes"
                                   Header="Quiet time before a session counts as finished (minutes)"
                                   Value="{x:Bind Settings.QuiescenceMinutes, Mode=OneWay}"
                                   Minimum="1"
                                   Maximum="240"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                   ValueChanged="OnBehaviorChanged" />
                        <NumberBox x:Name="ApprovalHoldSeconds"
                                   Header="How long you can take something back (seconds after approval)"
                                   Value="{x:Bind Settings.ApprovalHoldSeconds, Mode=OneWay}"
                                   Minimum="0"
                                   Maximum="300"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                   ValueChanged="OnBehaviorChanged" />
                        <TextBlock Text="No undo window. Approving sends on the next pass."
                                   Visibility="{x:Bind Settings.HasNoUndoWindow, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <NumberBox x:Name="DigestHours"
                                   Header="How often you can be interrupted (hours between notifications, at most)"
                                   Value="{x:Bind Settings.DigestHours, Mode=OneWay}"
                                   Minimum="1"
                                   Maximum="24"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                   ValueChanged="OnBehaviorChanged" />
                        <TextBlock Text="{x:Bind Settings.QueueExpiryText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.NotificationOwnerText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="These govern the background watcher, not this window, and take effect as soon as they are changed. The same values are readable and settable from the command line."
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="PROJECTS"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <TextBlock Text="No projects seen yet."
                           Visibility="{x:Bind Settings.HasNoProjects, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProjectSettingViewModel">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,3">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ProjectLabel}"
                                               Style="{StaticResource TcBodyDenseTextStyle}"
                                               TextWrapping="Wrap" />
                                    <!--
                                        Only the unresolvable bucket carries a
                                        note, saying why it can never be armed.
                                        Collapsed on every other row.
                                    -->
                                    <TextBlock Text="{x:Bind Note}"
                                               Visibility="{x:Bind HasNote}"
                                               Style="{StaticResource TcCaptionTextStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <!--
                                    Top rather than centre: a row carrying the
                                    note is three times the height of an
                                    ordinary one, and centred controls would
                                    float away from the name they act on.
                                -->
                                <TextBlock Grid.Column="1" Text="{x:Bind StateText, Mode=OneWay}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           VerticalAlignment="Top" />
                                <Button Grid.Column="2" Content="{x:Bind ActionText, Mode=OneWay}"
                                        IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                        VerticalAlignment="Top"
                                        Click="OnProjectMode"
                                        Style="{StaticResource TcSecondaryButtonStyle}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Arming a project so it contributes without asking is a deliberate confirmation flow, and it is not built yet."
                           Style="{StaticResource TcCaptionTextStyle}"
                           TextWrapping="Wrap" />

                <!--
                    The routing surface.

                    Every string in this block is bound. Not one is typed
                    here: the wording lives once, in
                    crates/trace-commons-contributor/src/routing_copy.rs, and
                    reaches this shell across the C ABI. One of the four words
                    is a privacy claim, so a word invented in this file would
                    be a claim invented in this file.

                    The whole section is collapsed when those words did not
                    arrive, rather than rendered with blanks beside the tool
                    names.
                -->
                <TextBlock Text="{x:Bind Settings.RoutingToolsHeading, Mode=OneWay}"
                           Visibility="{x:Bind Settings.RoutingAvailable, Mode=OneWay}"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind Settings.RoutingAvailable, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind Settings.RoutingIntro, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <!--
                            One row per tool, one word each. The word comes
                            from what IronWire answered about that tool, never
                            from the switch below.
                        -->
                        <ItemsControl ItemsSource="{x:Bind Settings.RoutingToolRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RoutingToolRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="8"
                                          Margin="0,2"
                                          AutomationProperties.Name="{x:Bind AccessibleLabel}">
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"
                                                   Style="{StaticResource TcBodyDenseTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Word}"
                                                   Style="{StaticResource TcMonoChipTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ToggleSwitch Header="{x:Bind Settings.RoutingToggleText, Mode=OneWay}"
                                      IsOn="{x:Bind Settings.RoutingDeclared, Mode=OneWay}"
                                      IsEnabled="{x:Bind Settings.IsNotBusy, Mode=OneWay}"
                                      Toggled="OnRoutingToggled" />
                        <TextBlock Text="{x:Bind Settings.RoutingAppliesAtOnceText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <!--
                            The port box shows the conventional number so
                            nobody has to know it. Showing is not declaring:
                            nothing is written until the switch above is on.
                        -->
                        <NumberBox Header="{x:Bind Settings.RoutingPortTitle, Mode=OneWay}"
                                   Value="{x:Bind Settings.RoutingPort, Mode=TwoWay}"
                                   Minimum="1"
                                   Maximum="65535"
                                   SmallChange="1"
                                   SpinButtonPlacementMode="Inline"
                                   IsEnabled="{x:Bind Settings.RoutingControlsEnabled, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Settings.RoutingPortNote, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <TextBox Header="{x:Bind Settings.RoutingFolderTitle, Mode=OneWay}"
                                 Text="{x:Bind Settings.RoutingTokenDir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{x:Bind Settings.RoutingControlsEnabled, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Settings.RoutingFolderNote, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />

                        <Button Content="{x:Bind Settings.RoutingApplyText, Mode=OneWay}"
                                IsEnabled="{x:Bind Settings.RoutingControlsEnabled, Mode=OneWay}"
                                Click="OnRoutingApply"
                                Style="{StaticResource TcSecondaryButtonStyle}" />

                        <TextBlock Text="{x:Bind Settings.RoutingProbeText, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.HasRoutingProbeText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Settings.RoutingStateText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            Per process, and shown only where there has been an
                            answer to be last. Never an install date.
                        -->
                        <TextBlock Text="{x:Bind Settings.RoutingLastChecked, Mode=OneWay}"
                                   Visibility="{x:Bind Settings.HasRoutingLastChecked, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Bind Settings.Notice, Mode=OneWay}"
                           Visibility="{x:Bind Settings.HasNotice, Mode=OneWay}"
                           Style="{StaticResource TcBodyDenseTextStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{x:Bind ViewModel.HeadingText}"
                           Style="{StaticResource TcTitleSectionTextStyle}" />

                <!--
                    Off the roster. One control, and turning it on does not
                    put anyone on the roster: it opens the consent dialog,
                    which is where the handle is typed and the acknowledgement
                    is given. Nothing is claimed by a toggle flip.
                -->
                <Border Visibility="{x:Bind ViewModel.IsNotListed, Mode=OneWay}"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.ListHandlePubliclyText}"
                                   Style="{StaticResource TcBodyTextStyle}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <!--
                            A ToggleSwitch with no on/off words, because the
                            row's own label already says what it does and the
                            switch is never the thing that grants anything.
                            It is put back to off if the dialog is abandoned:
                            see OnGoPublicToggled.
                        -->
                        <ToggleSwitch x:Name="GoPublicToggle"
                                      Grid.Column="1"
                                      OnContent=""
                                      OffContent=""
                                      IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                      AutomationProperties.Name="{x:Bind ViewModel.ListHandlePubliclyText}"
                                      Toggled="OnGoPublicToggled" />
                    </Grid>
                </Border>

                <!--
                    On the roster. The fields as published, and the two acts
                    available on them.

                    Save re-publishes the WHOLE profile, because that is what
                    the PUT does: the handle and the bio as they stand in
                    these two boxes, both of them, every time. There is no
                    partial update to offer, so there is no per field save.
                -->
                <Border Visibility="{x:Bind ViewModel.IsListed, Mode=OneWay}"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcGreenChipBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="16,14">
                    <StackPanel Spacing="12">

                        <TextBlock Text="{x:Bind ViewModel.OnRosterSinceText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasOnRosterSince, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   HorizontalAlignment="Right" />

                        <TextBox Header="{x:Bind ViewModel.HandleLabelText}"
                                 Text="{x:Bind ViewModel.Handle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="{ThemeResource TcMonoFontFamily}"
                                 IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />

                        <StackPanel Spacing="4">
                            <TextBox Header="{x:Bind ViewModel.BioLabelText}"
                                     Text="{x:Bind ViewModel.Bio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="78"
                                     IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}" />
                            <!--
                                The counter counts UTF-8 bytes, which is the
                                unit the budget is denominated in, and it
                                refuses nothing: what happens at and above the
                                limit is the server's call.
                            -->
                            <TextBlock Text="{x:Bind ViewModel.BioCounterText, Mode=OneWay}"
                                       Style="{StaticResource TcCaptionSmallTextStyle}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Style="{StaticResource TcPrimaryButtonStyle}"
                                    Content="{x:Bind ViewModel.SaveProfileText}"
                                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                    Click="OnSaveProfile" />
                            <Button Style="{StaticResource TcSecondaryButtonStyle}"
                                    Content="{x:Bind ViewModel.LeaveRosterText}"
                                    IsEnabled="{x:Bind ViewModel.IsNotBusy, Mode=OneWay}"
                                    Click="OnLeaveRoster" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--
                    What the last act actually did. It is the one place this
                    screen reports an outcome, and the sentence is chosen in
                    TraceCommons.Interop.PublicProfileCopy rather than here: a
                    claim the daemon could not cache locally is still a
                    PUBLISHED profile, and saying otherwise is the one error
                    this surface must never make.
                -->
                <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                           Style="{StaticResource TcBodyDenseTextStyle}"
                           TextWrapping="Wrap" />

                <TextBlock Text="{x:Bind ViewModel.FootnoteText}"
                           Style="{StaticResource TcCaptionTextStyle}"
                           Foreground="{ThemeResource TcInkTertiaryBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Text="WHAT HAS BEEN CHANGED ON THIS MACHINE"
                           Style="{StaticResource TcEyebrowTextStyle}" />
                <TextBlock Text="Nothing has been changed."
                           Visibility="{x:Bind Settings.HasNoAuditEntries, Mode=OneWay}"
                           Style="{StaticResource TcCaptionTextStyle}" />
                <ItemsControl ItemsSource="{x:Bind Settings.AuditEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AuditSettingViewModel">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,3">
                                <TextBlock Grid.Column="0" Text="{x:Bind AtText}"
                                           Style="{StaticResource TcMonoChipTextStyle}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind WhatText}"
                                           Style="{StaticResource TcCaptionTextStyle}"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
