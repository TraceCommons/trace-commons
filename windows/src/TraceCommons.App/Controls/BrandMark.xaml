<?xml version="1.0" encoding="utf-8"?>
<!--
    "The Turn" - the Trace Commons mark (design spec 1.2).

    The user's bracket in green at the top left, the agent's answer in blue at
    the bottom right, the session implied between them. Pure geometry: no
    gradients, and no fill anywhere except the frame. The geometry below is the
    spec's SVG transcribed one number at a time, on the same 64-unit viewBox,
    so the proportions survive any scale.

    Both variants are drawn and one is hidden, rather than one canvas being
    recoloured from code. Colours have to come through {ThemeResource} to
    follow a light/dark flip at runtime, and a brush assigned in code-behind
    stops re-resolving the moment it is assigned.
-->
<UserControl
    x:Class="TraceCommons.App.Controls.BrandMark"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False"
    IsHitTestVisible="False"
    AutomationProperties.AccessibilityView="Raw">

    <Viewbox Stretch="Uniform">
        <Grid Width="64" Height="64">

            <!-- The framed variant, for window chrome and anywhere the mark
                 sits on a surface of its own. -->
            <Canvas x:Name="FramedMark" Width="64" Height="64">
                <!-- Inset 1 unit with a 2-unit stroke, so the frame sits
                     exactly on the 64x64 edge. -->
                <Rectangle Canvas.Left="1" Canvas.Top="1"
                           Width="62" Height="62"
                           Fill="{ThemeResource TcMarkFieldBrush}"
                           Stroke="{ThemeResource TcMarkInkBrush}"
                           StrokeThickness="2" />
                <Path Data="M11 28V11h17"
                      Stroke="{ThemeResource TcMarkAccentBrush}"
                      StrokeThickness="7" />
                <Path Data="M53 36v17H36"
                      Stroke="{ThemeResource TcMarkInkBrush}"
                      StrokeThickness="7" />
            </Canvas>

            <!-- The template variant: frameless, single ink, for a tray icon
                 or any host that recolours what it is given. The stroke
                 thickens from 7 to 8 to survive the loss of the frame. -->
            <Canvas x:Name="TemplateMark" Width="64" Height="64" Visibility="Collapsed">
                <Path Data="M11 28V11h17"
                      Stroke="{ThemeResource TcInkPrimaryBrush}"
                      StrokeThickness="8" />
                <Path Data="M53 36v17H36"
                      Stroke="{ThemeResource TcInkPrimaryBrush}"
                      StrokeThickness="8" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
