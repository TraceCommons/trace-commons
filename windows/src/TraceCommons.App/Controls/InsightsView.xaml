<UserControl
    x:Class="TraceCommons.App.Controls.InsightsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Overview, Patterns and Sessions over the saved snapshots, then
        Analyze, the whole earlier screen. Every word is bound to the
        core's copy; every figure is the core's. Bars are plain
        rectangles, never a ring. Spend is not a tab: it sits beside the
        tabs, disabled, with its Later chip.
    -->
    <Pivot x:Name="Tabs" SelectionChanged="OnTabChanged">
        <Pivot.RightHeader>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,28,0" Opacity="0.5" IsHitTestVisible="False">
                <TextBlock Text="{Binding [analytics_tab_spend]}" VerticalAlignment="Center" />
                <Border BorderBrush="{ThemeResource TcHairlineBrush}" BorderThickness="1" CornerRadius="8" Padding="8,2">
                    <TextBlock Text="{Binding [analytics_later]}" FontSize="12" />
                </Border>
            </StackPanel>
        </Pivot.RightHeader>
        <PivotItem Header="{Binding [analytics_tab_overview]}">
            <ScrollViewer>
                <StackPanel Padding="28" Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding [analytics_this_week]}" FontSize="22" VerticalAlignment="Center" />
                        <ComboBox x:Name="OverviewWeek" ItemsSource="{Binding Overview.Weeks}" DisplayMemberPath="Label"
                                  SelectedIndex="{Binding Overview.SelectedWeekIndex}" SelectionChanged="OnOverviewWeek"
                                  AutomationProperties.Name="{Binding [analytics_this_week]}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Overview.Status}" FontSize="22" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Overview.CoverageLine}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Overview.Notes}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <Button Tag="tokens" Click="OnOverviewCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                ToolTipService.ToolTip="{Binding [analytics_drill_title]}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding [analytics_card_tokens]}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.TokensEmpty}" FontSize="20" />
                                <ItemsControl ItemsSource="{Binding Overview.TokenLines}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Spacing="2" Padding="0,0,0,8">
                                            <TextBlock Text="{Binding Figure}" FontSize="20" />
                                            <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Change}" FontSize="12" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Tag="cache_share" Click="OnOverviewCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                ToolTipService.ToolTip="{Binding [analytics_drill_title]}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding [analytics_card_cache_share]}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.TokensEmpty}" FontSize="20" />
                                <ItemsControl ItemsSource="{Binding Overview.CacheLines}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <StackPanel Spacing="4" Padding="0,0,0,8">
                                            <Grid Width="160" Height="6" HorizontalAlignment="Left">
                                                <Rectangle Fill="{ThemeResource TcSurfaceInsetBrush}" RadiusX="3" RadiusY="3" />
                                                <Rectangle Fill="{ThemeResource TcAccentBrush}" Width="{Binding Length}" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" />
                                            </Grid>
                                            <TextBlock Text="{Binding Line}" FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Best}" FontSize="12" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Tag="sessions" Click="OnOverviewCard" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                ToolTipService.ToolTip="{Binding [analytics_drill_title]}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding [analytics_card_sessions]}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Text="{Binding Overview.SessionsFigure}" FontSize="20" />
                                <ItemsControl ItemsSource="{Binding Overview.LargestLines}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" />
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding Overview.InputsTitle}" FontSize="18" />
                    <ItemsControl ItemsSource="{Binding Overview.InputsSources}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding}" IsTextSelectionEnabled="True" />
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ContentControl Content="{Binding Overview.InputsHeader}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                        <ContentControl.ContentTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,*,*,2*" ColumnSpacing="12">
                                <TextBlock Text="{Binding Session}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Tokens}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Coverage}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Reason}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                            </Grid>
                        </DataTemplate></ContentControl.ContentTemplate>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding Overview.Inputs}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,*,*,2*" ColumnSpacing="12" Padding="0,4">
                                <TextBlock Text="{Binding Session}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="{ThemeResource TcMonoFontFamily}" />
                                <TextBlock Grid.Column="1" Text="{Binding Tokens}" />
                                <TextBlock Grid.Column="2" Text="{Binding Coverage}" />
                                <TextBlock Grid.Column="3" Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding [analytics_card_tokens_by_day]}" FontSize="18" />
                    <TextBlock Text="{Binding Overview.DaysEmpty}" />
                    <ItemsControl ItemsSource="{Binding Overview.Days}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,2">
                                <TextBlock Text="{Binding Date}" Width="96" />
                                <ItemsControl ItemsSource="{Binding Bars}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Width="160" Height="8" ToolTipService.ToolTip="{Binding Figure}" AutomationProperties.Name="{Binding Label}">
                                            <Rectangle Fill="{ThemeResource TcSurfaceInsetBrush}" />
                                            <Rectangle Fill="{ThemeResource TcAccentBrush}" Width="{Binding Length}" HorizontalAlignment="Left" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Overview.CodexIntervalLabel}" FontSize="12" />
                        <TextBlock Text="{Binding Overview.CodexIntervalFigure}" FontSize="12" />
                    </StackPanel>
                    <TextBlock Text="{Binding [analytics_card_by_model]}" FontSize="18" />
                    <ItemsControl ItemsSource="{Binding Overview.Models}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,Auto,*" ColumnSpacing="12" Padding="0,2">
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                <Rectangle Grid.Column="1" Fill="{ThemeResource TcAccentBrush}" Width="{Binding Length}" Height="6" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="2" Text="{Binding Figure}" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding [analytics_model_labels_note]}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                    <TextBlock Text="{Binding [analytics_card_by_project]}" FontSize="18" />
                    <TextBlock Text="{Binding Overview.ProjectFigure}" />
                    <TextBlock Text="{Binding Overview.ProjectNote}" FontSize="12" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                    <TextBlock Text="{Binding [analytics_card_by_tool]}" FontSize="18" />
                    <ItemsControl ItemsSource="{Binding Overview.Tools}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12" Padding="0,2">
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Grid.Column="1" Text="{Binding Figure}" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="{Binding [analytics_tab_patterns]}">
            <ScrollViewer>
                <StackPanel Padding="28" Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="{Binding [analytics_where_tokens_went]}" FontSize="22" VerticalAlignment="Center" />
                        <ComboBox x:Name="PatternsWeek" ItemsSource="{Binding Patterns.Weeks}" DisplayMemberPath="Label"
                                  SelectedIndex="{Binding Patterns.SelectedWeekIndex}" SelectionChanged="OnPatternsWeek"
                                  AutomationProperties.Name="{Binding [analytics_this_week]}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Patterns.Status}" FontSize="22" AutomationProperties.LiveSetting="Polite" />
                    <ItemsControl ItemsSource="{Binding Patterns.Notes}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Patterns.Cards}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{ThemeResource TcSurfaceCardBrush}" BorderBrush="{ThemeResource TcHairlineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Width="220">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Headline}" FontSize="22" />
                                    <TextBlock Text="{Binding CountLine}" FontSize="12" TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding Weeks}" Height="48">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid Width="14" Height="48" ToolTipService.ToolTip="{Binding Figure}" AutomationProperties.Name="{Binding Label}">
                                                <Rectangle Fill="{ThemeResource TcAccentBrush}" Height="{Binding Length}" VerticalAlignment="Bottom" />
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Change}" FontSize="12" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                    <TextBlock Text="{Binding Basis}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                    <HyperlinkButton Content="{Binding SeeSessions}" Tag="{Binding Kind}" IsEnabled="{Binding HasSessions}" Click="OnPatternSessions" />
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Patterns.ClaudeOnlyLine}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Patterns.SessionsTitle}" FontSize="18" />
                    <ContentControl Content="{Binding Patterns.SessionsHeader}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                        <ContentControl.ContentTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,*,*,2*" ColumnSpacing="12">
                                <TextBlock Text="{Binding Session}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Tokens}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding Coverage}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Reason}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                            </Grid>
                        </DataTemplate></ContentControl.ContentTemplate>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding Patterns.Sessions}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,*,*,2*" ColumnSpacing="12" Padding="0,4">
                                <TextBlock Text="{Binding Session}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="{ThemeResource TcMonoFontFamily}" />
                                <TextBlock Grid.Column="1" Text="{Binding Tokens}" />
                                <TextBlock Grid.Column="2" Text="{Binding Coverage}" />
                                <TextBlock Grid.Column="3" Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding [analytics_reread_title]}" FontSize="18" />
                    <TextBlock Text="{Binding Patterns.RereadEmpty}" />
                    <ContentControl Content="{Binding Patterns.RereadHeader}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch">
                        <ContentControl.ContentTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,*,2*,*" ColumnSpacing="12">
                                <TextBlock Text="{Binding File}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Reads}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="{Binding AfterShrink}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="{Binding Tokens}" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                            </Grid>
                        </DataTemplate></ContentControl.ContentTemplate>
                    </ContentControl>
                    <ItemsControl ItemsSource="{Binding Patterns.Reread}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Grid ColumnDefinitions="2*,*,2*,*" ColumnSpacing="12" Padding="0,2">
                                <TextBlock Text="{Binding File}" FontFamily="{ThemeResource TcMonoFontFamily}" />
                                <TextBlock Grid.Column="1" Text="{Binding Reads}" />
                                <TextBlock Grid.Column="2" Text="{Binding AfterShrink}" />
                                <TextBlock Grid.Column="3" Text="{Binding Tokens}" />
                            </Grid>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="{Binding [analytics_tab_sessions]}">
            <ScrollViewer>
                <StackPanel Padding="28" Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <ComboBox x:Name="SessionChoice" ItemsSource="{Binding Sessions.Choices}" DisplayMemberPath="Label"
                              SelectedIndex="{Binding Sessions.SelectedIndex}" SelectionChanged="OnSessionChoice"
                              AutomationProperties.Name="{Binding [analytics_drill_session]}" />
                    <TextBlock Text="{Binding Sessions.Status}" FontSize="22" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding Sessions.Header}" FontSize="20" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Sessions.Notes}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Sessions.UnavailableLine}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Sessions.ChartTitle}" FontSize="18" />
                    <ItemsControl ItemsSource="{Binding Sessions.Legend}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16" />
                        </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="12" />
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Sessions.ThresholdLine}" FontSize="12" Foreground="{ThemeResource TcInkSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Sessions.Turns}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,2">
                                <TextBlock Text="{Binding Label}" Width="80" />
                                <TextBlock Text="{Binding Letters}" Width="40" FontFamily="{ThemeResource TcMonoFontFamily}" />
                                <ItemsControl ItemsSource="{Binding Bars}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="8" />
                                    </ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Width="160" Height="8" ToolTipService.ToolTip="{Binding Figure}" AutomationProperties.Name="{Binding Label}">
                                            <Rectangle Fill="{ThemeResource TcSurfaceInsetBrush}" />
                                            <Rectangle Fill="{ThemeResource TcAccentBrush}" Width="{Binding Length}" HorizontalAlignment="Left" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Gap}" />
                            </StackPanel>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Sessions.Markers}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="{ThemeResource TcSurfaceCardBrush}" BorderBrush="{ThemeResource TcHairlineBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Letter}" FontSize="20" FontFamily="{ThemeResource TcMonoFontFamily}" />
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="16" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
        <PivotItem Header="{Binding [analytics_tab_analyze]}">
            <ScrollViewer>
                <StackPanel Padding="28" Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">
                    <TextBlock Text="{Binding Title}" FontSize="28" />
                    <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SnapshotNotice}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="Source" Header="{Binding [source]}" SelectedIndex="0" IsEnabled="{Binding Idle}">
                            <ComboBoxItem Content="{Binding [codex]}" Tag="codex" />
                            <ComboBoxItem Content="{Binding [claude_code]}" Tag="claude_code" />
                            <ComboBoxItem Content="{Binding [trajectory]}" Tag="trajectory" />
                        </ComboBox>
                        <Button Content="{Binding [choose_file]}" Click="OnChoose" IsEnabled="{Binding Idle}" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="SelectedFile" Text="{Binding [no_file]}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="{Binding [analyze]}" Click="OnAnalyze" IsEnabled="{Binding Idle}" />
                        <Button Content="{Binding [save]}" Click="OnSave" IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding [save_accessibility]}" />
                        <Button Content="{Binding [cancel]}" Click="OnCancel" IsEnabled="{Binding Busy}" />
                    </StackPanel>
                    <TextBlock Text="{Binding [save_notice]}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding CancellationNotice}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding MutationNotice}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding [summary_title]}" FontSize="22" />
                    <TextBlock Text="{Binding SummaryStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Text="{Binding SummaryDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Expander Header="{Binding [summary_title]}" IsExpanded="False" HorizontalAlignment="Stretch">
                        <ItemsControl ItemsSource="{Binding SummaryRows}" IsEnabled="{Binding Idle}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="8" Padding="0,8">
                                        <TextBlock Text="{Binding Label}" FontSize="18" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <ItemsControl ItemsSource="{Binding Evidence}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding Id}" Click="OnSummaryEvidence" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Button Content="{Binding [refresh]}" Click="OnRefresh" IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding [refresh_accessibility]}" />
                    <ListView x:Name="SavedList" ItemsSource="{Binding Saved}" DisplayMemberPath="Label" MaxHeight="200" SelectionMode="Multiple" IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding [saved]}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="{Binding [explain]}" Click="OnExplain" IsEnabled="{Binding Idle}" />
                        <Button Content="{Binding [delete]}" Click="OnDelete" IsEnabled="{Binding HasSavedSelection}" AutomationProperties.Name="{Binding [delete_accessibility]}" />
                    </StackPanel>
                    <Expander Header="{Binding [card_title]}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding [card_selection_notice]}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding [card_choose_evidence]}" FontSize="18" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding [card_evidence]}" TextWrapping="Wrap" />
                            <ListView x:Name="CardSavedList" ItemsSource="{Binding Saved}" DisplayMemberPath="Label"
                                      MaxHeight="160" SelectionMode="Multiple" IsEnabled="{Binding Idle}"
                                      AutomationProperties.Name="{Binding [card_evidence]}" />
                            <TextBlock Text="{Binding [card_episodes]}" TextWrapping="Wrap" />
                            <ListView x:Name="CardEpisodeList" ItemsSource="{Binding Episodes}" DisplayMemberPath="Label"
                                      MaxHeight="160" SelectionMode="Multiple" IsEnabled="{Binding Idle}"
                                      AutomationProperties.Name="{Binding [card_episodes]}" />
                            <Button Content="{Binding [card_update]}" Click="OnLoadQuestionCards" IsEnabled="{Binding Idle}" />
                            <TextBlock Text="{Binding CardStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <ItemsControl ItemsSource="{Binding QuestionCards}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Expander Header="{Binding Question}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6" Padding="0,6">
                                            <TextBlock Text="{Binding State}" FontSize="18" />
                                            <TextBlock Text="{Binding MetricVersion}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <ItemsControl ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </Grid>
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Coverage}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{Binding Limitations}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Omission}" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Evidence}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Button Content="{Binding Label}" Tag="{Binding Id}" Click="OnCardEvidence"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <ItemsControl ItemsSource="{Binding Episodes}">
                                                <ItemsControl.ItemTemplate><DataTemplate>
                                                    <Button Content="{Binding Label}" Tag="{Binding Id}" Click="OnCardEpisode"
                                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                                                </DataTemplate></ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <Expander Header="{Binding [episode_title]}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding [episode_scope]}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding [episode_create_notice]}" TextWrapping="Wrap" />
                            <Button Content="{Binding [episode_create]}" Click="OnCreateEpisode" IsEnabled="{Binding Idle}" />
                            <TextBlock Text="{Binding EpisodeStatus}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <ListView x:Name="EpisodeList" ItemsSource="{Binding Episodes}" DisplayMemberPath="Label" MaxHeight="180" SelectionMode="Single" IsEnabled="{Binding Idle}" AutomationProperties.Name="{Binding [episode_saved]}" />
                            <Button Content="{Binding [episode_open]}" Click="OnOpenEpisode" IsEnabled="{Binding Idle}" />
                            <TextBlock Text="{Binding [episode_overlap_notice]}" TextWrapping="Wrap" />
                            <TextBlock x:Name="EpisodeDetail" Text="{Binding EpisodeDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <ItemsControl ItemsSource="{Binding EpisodeMembers}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Expander Header="{Binding Label}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{Binding Id}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding [episode_edit_members_notice]}" TextWrapping="Wrap" />
                            <Button Content="{Binding [episode_save_members]}" Click="OnSaveEpisodeMembers" IsEnabled="{Binding HasEpisodeSelection}" />
                            <TextBlock Text="{Binding [episode_assessment_notice]}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <ComboBox IsEnabled="{Binding HasEpisodeSelection}" Header="{Binding [category]}" SelectedIndex="{Binding EpisodeCategoryIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{Binding [category_refactor]}" /><ComboBoxItem Content="{Binding [category_tests]}" />
                                    <ComboBoxItem Content="{Binding [category_docs]}" /><ComboBoxItem Content="{Binding [category_debugging]}" />
                                    <ComboBoxItem Content="{Binding [category_other]}" /><ComboBoxItem Content="{Binding [category_unknown]}" />
                                </ComboBox>
                                <ComboBox IsEnabled="{Binding HasEpisodeSelection}" Header="{Binding [outcome]}" SelectedIndex="{Binding EpisodeOutcomeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="{Binding [outcome_accepted]}" /><ComboBoxItem Content="{Binding [outcome_partial]}" />
                                    <ComboBoxItem Content="{Binding [outcome_rejected]}" /><ComboBoxItem Content="{Binding [outcome_unknown]}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="{Binding [episode_save_assessment]}" Click="OnSaveEpisodeAssessment" IsEnabled="{Binding HasEpisodeSelection}" AutomationProperties.Name="{Binding [episode_save_assessment_accessibility]}" />
                                <Button Content="{Binding [episode_clear_assessment]}" Click="OnClearEpisodeAssessment" IsEnabled="{Binding HasEpisodeSelection}" />
                                <Button Content="{Binding [episode_delete]}" Click="OnDeleteEpisode" IsEnabled="{Binding HasEpisodeSelection}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding CoverageNotice}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding EvidenceNotice}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [boundary_notice]}" TextWrapping="Wrap" />
                    <TextBlock x:Name="SnapshotDetail" Text="{Binding Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Expander Header="{Binding [model_title]}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding ModelDetails}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            <Expander Header="{Binding [model_references]}">
                                <ItemsControl ItemsSource="{Binding ModelReferences}">
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Expander>
                    <Expander Header="{Binding [linked_evidence_title]}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding [link_notice]}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EvidenceSelectionStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding OutcomeEvidenceStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding [link_git_notice]}" TextWrapping="Wrap" />
                            <TextBox Header="{Binding [link_commit]}" Text="{Binding CommitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasSavedSelection}" />
                            <Button Content="{Binding [link_git]}" Click="OnLinkGit" IsEnabled="{Binding HasSavedSelection}" />
                            <TextBlock Text="{Binding [link_test_notice]}" TextWrapping="Wrap" />
                            <Expander Header="{Binding [choose_test_report]}">
                                <TextBlock Text="{Binding [test_report_format]}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                            </Expander>
                            <Button Content="{Binding [link_test_report]}" Click="OnLinkTestReport" IsEnabled="{Binding HasSavedSelection}" />
                            <ItemsControl ItemsSource="{Binding OutcomeEvidence}" IsEnabled="{Binding HasSavedSelection}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Expander Header="{Binding Label}" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding Details}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                            <Button Content="{Binding UnlinkLabel}" Tag="{Binding}" Click="OnUnlinkEvidence" />
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="{Binding AssessmentNotice}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="Category" IsEnabled="{Binding HasSavedSelection}" Header="{Binding [category]}" SelectedIndex="{Binding CategoryIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{Binding [category_refactor]}" Tag="refactor" />
                            <ComboBoxItem Content="{Binding [category_tests]}" Tag="tests" />
                            <ComboBoxItem Content="{Binding [category_docs]}" Tag="docs" />
                            <ComboBoxItem Content="{Binding [category_debugging]}" Tag="debugging" />
                            <ComboBoxItem Content="{Binding [category_other]}" Tag="other" />
                            <ComboBoxItem Content="{Binding [category_unknown]}" Tag="unknown" />
                        </ComboBox>
                        <ComboBox x:Name="Outcome" IsEnabled="{Binding HasSavedSelection}" Header="{Binding [outcome]}" SelectedIndex="{Binding OutcomeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{Binding [outcome_accepted]}" Tag="accepted" />
                            <ComboBoxItem Content="{Binding [outcome_partial]}" Tag="partial" />
                            <ComboBoxItem Content="{Binding [outcome_rejected]}" Tag="rejected" />
                            <ComboBoxItem Content="{Binding [outcome_unknown]}" Tag="unknown" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="{Binding [save_assessment]}" Click="OnAnnotate" IsEnabled="{Binding HasSavedSelection}" />
                        <Button Content="{Binding [clear_assessment]}" Click="OnClear" IsEnabled="{Binding HasSavedSelection}" />
                    </StackPanel>
                    <Button Content="{Binding [contributions]}" Click="OnContributions" />
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</UserControl>
