<?xml version="1.0" encoding="utf-8"?>
<!--
    The model calls destination.

    Not one string on this screen is typed here, the title and the screen's
    own name included. Every word arrives from
    crates/trace-commons-contributor/src/private_inference_copy.rs across the
    C ABI, and the whole screen collapses when they did not arrive rather
    than drawing a switch with nothing beside it. That shape is what says
    "on" over a listener that refused to start.

    The switch and the status line are two different claims and are drawn as
    two different things. The switch is where the contributor put it; the
    status line is what the daemon reported, coloured from the tone and never
    from the switch's own value. A contributor who turned this on over a port
    that was already taken must see the refusal, not a green light.

    XML comments cannot contain a double hyphen, so the prose here uses
    commas and parentheses where the C# files use dashes.
-->
<UserControl
    x:Class="TraceCommons.App.Controls.PrivateInferenceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:TraceCommons.App.ViewModels"
    xmlns:local="using:TraceCommons.App.Controls"
    xmlns:interop="using:TraceCommons.Interop"
    xmlns:shell="using:TraceCommons.Interop.Shell"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>

        <ScrollViewer Padding="22,16,22,16">
            <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
                <!--
                    How Private AI works (spec W19, PrivateAIGuideCard,
                    InferenceViews.swift:369-405): first on the tab until it is
                    closed with its X, in the managed table's words. Drawn as
                    GetStartedCard draws it: a title, a line, numbered steps
                    each in a card of its own. No step has a link. The Mac's
                    pixel field behind it is not ported yet (listed in the PR).
                -->
                <Border x:Name="GuideCard"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind local:PrivateInferenceView.Shown(Guide.IsShown)}">
                    <StackPanel Spacing="20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Guide.Title}"
                                           AutomationProperties.HeadingLevel="Level1"
                                           FontSize="22" FontWeight="ExtraBold" LineHeight="28"
                                           Foreground="{ThemeResource TcInkPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind Guide.Lead}"
                                           Style="{StaticResource TcBodyTextStyle}"
                                           Foreground="{ThemeResource TcInkSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="20" Height="20" Padding="0"
                                    VerticalAlignment="Top"
                                    Background="Transparent" BorderThickness="0"
                                    AutomationProperties.Name="{x:Bind Guide.CloseName}"
                                    ToolTipService.ToolTip="{x:Bind Guide.CloseName}"
                                    Click="OnCloseGuide">
                                <FontIcon Glyph="&#xE711;" FontSize="10" />
                            </Button>
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind Guide.Steps}" IsTabStop="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="interop:GuideStep">
                                    <Border Background="{ThemeResource TcSurfaceInsetBrush}"
                                            CornerRadius="{StaticResource TcCardCornerRadius}"
                                            Padding="12,8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <Grid Width="18" Height="18" VerticalAlignment="Top">
                                                <Ellipse Fill="{ThemeResource TcSurfaceCardBrush}" />
                                                <TextBlock Text="{x:Bind NumberText}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{ThemeResource TcAccentTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Text="{x:Bind Title}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource TcInkPrimaryBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Line}" FontSize="12" LineHeight="16"
                                                           Foreground="{ThemeResource TcInkSecondaryBrush}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--
                    The tab's heading row (PrivateAIInspectorView.summary,
                    InferenceViews.swift:444-472; GlassTabHeading and GlassChip):
                    the status title in the card-title face, the state's one
                    word in a pill with its dot right after it, the core's
                    full sentence as the row's tooltip and help text, and the
                    subtitle under it in body type, secondary ink.
                -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.Available, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="28"
                                ToolTipService.ToolTip="{x:Bind ViewModel.Heading.Sentence, Mode=OneWay}"
                                AutomationProperties.HelpText="{x:Bind ViewModel.Heading.Sentence, Mode=OneWay}">
                        <!-- A StackPanel has no automation peer, so the sentence rides on the title. -->
                        <TextBlock Text="{x:Bind ViewModel.Heading.Title, Mode=OneWay}"
                                   AutomationProperties.HelpText="{x:Bind ViewModel.Heading.Sentence, Mode=OneWay}"
                                   AutomationProperties.HeadingLevel="Level2"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TcInkPrimaryBrush}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Border CornerRadius="{StaticResource TcPillCornerRadius}" Padding="9,3" VerticalAlignment="Center"
                                Background="{ThemeResource TcSurfaceInsetBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource TcStatusOnBrush}"
                                         Visibility="{x:Bind local:PrivateInferenceView.DotShown(ViewModel.Heading.Dot, shell:DotStatus.On), Mode=OneWay}" />
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource TcStatusAskBrush}"
                                         Visibility="{x:Bind local:PrivateInferenceView.DotShown(ViewModel.Heading.Dot, shell:DotStatus.Ask), Mode=OneWay}" />
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource TcStatusOutsideBrush}"
                                         Visibility="{x:Bind local:PrivateInferenceView.DotShown(ViewModel.Heading.Dot, shell:DotStatus.Outside), Mode=OneWay}" />
                                <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource TcStatusOffBrush}"
                                         Visibility="{x:Bind local:PrivateInferenceView.DotShown(ViewModel.Heading.Dot, shell:DotStatus.Off), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.Heading.Word, Mode=OneWay}"
                                           Style="{StaticResource TcMonoChipTextStyle}"
                                           Foreground="{x:Bind local:PrivateInferenceView.DotInk(ViewModel.Heading.Dot), Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Heading.Subtitle, Mode=OneWay}"
                               Style="{StaticResource TcBodyTextStyle}"
                               Foreground="{ThemeResource TcInkSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--
                    Choose a spending organization (spec W19-D2 (a),
                    SpendOrganizationPrompt.swift): only when the daemon asks,
                    in its words. The action opens Settings; Not now keeps the
                    organization in use.
                -->
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcGoldAttentionBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind local:PrivateInferenceView.Shown(SpendPrompt.IsShown), Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind SpendPrompt.Title, Mode=OneWay}"
                                   Style="{StaticResource TcTitleCardTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind SpendPrompt.Line, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="{x:Bind SpendPrompt.Action, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind SpendPrompt.ActionName, Mode=OneWay}"
                                    Style="{StaticResource TcSecondaryButtonStyle}"
                                    Click="OnSpendPromptAction" />
                            <HyperlinkButton Content="{x:Bind SpendPrompt.Dismiss, Mode=OneWay}"
                                             AutomationProperties.Name="{x:Bind SpendPrompt.DismissName, Mode=OneWay}"
                                             Click="OnSpendPromptDismiss" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ContentControl x:Name="ManagedContent" IsTabStop="False" />

                <!--
                    The ledger (spec W19, InferenceTabView.ledgerSections,
                    InferenceViews.swift:91-117): a failed read in the core's
                    words, the window and its totals, then the calls. An
                    unreadable ledger draws nothing, never an empty table.
                -->
                <!--
                    GlassNotice(tone: .outside) (Containers.swift:755-812):
                    the tone's warning icon in its colour, the title beside
                    it, on the tone's colour at 0.14, padded 10 all round.
                -->
                <Grid Visibility="{x:Bind local:PrivateInferenceView.Shown(Ledger.HasFailure), Mode=OneWay}">
                    <Border CornerRadius="{StaticResource TcCardCornerRadius}"
                            Background="{ThemeResource TcStatusOutsideBrush}" Opacity="0.14" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="10">
                        <FontIcon Glyph="&#xE7BA;" FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0"
                                  Foreground="{ThemeResource TcStatusOutsideBrush}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Ledger.FailureLine, Mode=OneWay}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TcInkPrimaryBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </Grid>
                </Grid>
                <ProgressRing IsActive="{x:Bind Ledger.Loading, Mode=OneWay}"
                              Visibility="{x:Bind local:PrivateInferenceView.Shown(Ledger.Loading), Mode=OneWay}"
                              Width="16" Height="16" HorizontalAlignment="Center" />
                <StackPanel Spacing="4"
                            Visibility="{x:Bind local:PrivateInferenceView.Shown(Ledger.ShowsHeader), Mode=OneWay}">
                    <TextBlock Text="{x:Bind Ledger.WindowLine, Mode=OneWay}"
                               Style="{StaticResource TcCaptionTextStyle}"
                               Foreground="{ThemeResource TcInkTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <StackPanel Spacing="2" MinWidth="72">
                            <TextBlock Text="{x:Bind Ledger.CallsWord, Mode=OneWay}" Style="{StaticResource TcCaptionTextStyle}"
                                       Foreground="{ThemeResource TcInkSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Ledger.CallsFigure, Mode=OneWay}" Style="{StaticResource TcMetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="2" MinWidth="72">
                            <TextBlock Text="{x:Bind Ledger.VerifiedWord, Mode=OneWay}" Style="{StaticResource TcCaptionTextStyle}"
                                       Foreground="{ThemeResource TcStatusOnTextBrush}" />
                            <TextBlock Text="{x:Bind Ledger.VerifiedFigure, Mode=OneWay}" Style="{StaticResource TcMetricValueTextStyle}" />
                        </StackPanel>
                        <StackPanel Spacing="2" MinWidth="72">
                            <TextBlock Text="{x:Bind Ledger.PricedWord, Mode=OneWay}" Style="{StaticResource TcCaptionTextStyle}"
                                       Foreground="{ThemeResource TcInkSecondaryBrush}" />
                            <TextBlock Text="{x:Bind Ledger.PricedFigure, Mode=OneWay}" Style="{StaticResource TcMetricValueTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind local:PrivateInferenceView.Shown(Ledger.ShowsCalls), Mode=OneWay}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind Ledger.CallsWord, Mode=OneWay}" Style="{StaticResource TcEyebrowTextStyle}" />
                        <ItemsControl ItemsSource="{x:Bind Ledger.Calls, Mode=OneWay}" IsTabStop="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="interop:LedgerCallRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="0,6"
                                          BorderBrush="{ThemeResource TcHairlineDividerBrush}" BorderThickness="0,1,0,0"
                                          AutomationProperties.Name="{x:Bind AccessibleName}">
                                        <TextBlock Text="{x:Bind Time}" MinWidth="56"
                                                   Style="{StaticResource TcMonoChipTextStyle}"
                                                   Foreground="{ThemeResource TcInkTertiaryBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{x:Bind Tool}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{ThemeResource TcInkPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Model}" Style="{StaticResource TcMonoChipTextStyle}"
                                                       Foreground="{ThemeResource TcInkTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind TokenLine}" Style="{StaticResource TcMonoChipTextStyle}"
                                                       Foreground="{ThemeResource TcInkTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind local:PrivateInferenceView.Shown(HasTokens)}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{x:Bind Priced}" Style="{StaticResource TcCaptionTextStyle}"
                                                   Foreground="{ThemeResource TcInkSecondaryBrush}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Proof.Text}" Style="{StaticResource TcCaptionTextStyle}"
                                                   Foreground="{x:Bind local:PrivateInferenceView.ToneBrush(Proof.Tone)}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!--
                    What is left in that account, after the calls and before
                    the card that opens Settings, where billing is
                    (InferenceTabView.ledger, InferenceViews.swift:83-84).

                    THIS CARD JUDGES NO AMOUNT. There is no threshold here, no
                    low balance colour and no warning: a figure this app
                    painted red would be inventing a limit nobody set, on an
                    account whose ceiling may not exist at all. The colours on
                    this card come from the state, and they say whether the
                    READ succeeded, never whether the money is comfortable.

                    The figure and its absence are two different things. An
                    empty amount is never zero: the account with no ceiling is
                    the ordinary one, it reports no remaining figure, and the
                    sentence in its place says so in words rather than letting
                    a contributor read $0.00 and top up money they still have.

                    On the one state that carries figures the state sentence
                    is deliberately empty, so nothing is drawn above the
                    number except the heading naming what it is.
                -->
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind ViewModel.ShowAccountBalance, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.BalanceTitle, Mode=OneWay}"
                                   Style="{StaticResource TcTitleSectionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            The figure the heading just named. No Foreground
                            of its own, deliberately: the ink is the card's,
                            and nothing here reads the number back to pick a
                            colour from it.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.BalanceAmountText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasBalanceAmount, Mode=OneWay}"
                                   Style="{StaticResource TcMetricValueTextStyle}" />
                        <!--
                            And where there is no figure, the sentence that
                            explains why there is not. Drawn only when the
                            figure is not, so the two never say it twice.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.BalanceRemainingText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasBalanceRemainingText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.BalanceWhat, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            One line per tone, chosen from the tone and never
                            from the text, exactly as the two cards around it
                            are. The whole group is absent on the state whose
                            sentence is empty, so a card of figures never
                            opens with a blank line.
                        -->
                        <StackPanel Spacing="0"
                                    Visibility="{x:Bind ViewModel.HasBalanceStateText, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.BalanceStateText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.BalanceIsNeutral, Mode=OneWay}"
                                       Style="{StaticResource TcCaptionTextStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BalanceStateText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.BalanceIsHeld, Mode=OneWay}"
                                       Style="{StaticResource TcCaptionTextStyle}"
                                       Foreground="{ThemeResource TcBlueBrandBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BalanceStateText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.BalanceIsClear, Mode=OneWay}"
                                       Style="{StaticResource TcCaptionTextStyle}"
                                       Foreground="{ThemeResource TcGreenTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BalanceStateText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.BalanceIsAttention, Mode=OneWay}"
                                       Style="{StaticResource TcCaptionTextStyle}"
                                       Foreground="{ThemeResource TcGoldTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.BalanceStateText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.BalanceIsRefused, Mode=OneWay}"
                                       Style="{StaticResource TcCaptionTextStyle}"
                                       Foreground="{ThemeResource TcCoralTextBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.BalanceLimitText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasBalanceLimitText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.BalanceSpentText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasBalanceSpentText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            When THIS COMPUTER asked. Not when the service
                            updated anything, which is a claim about its
                            bookkeeping that nothing here supports.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.BalanceObservedText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasBalanceObservedText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionSmallTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            The way back in, and it is the sign-in card's own
                            action: the same words, the same cost sentence and
                            the same ceremony. Withheld while that card is
                            already offering one, because two buttons that
                            mint the same key are one button too many.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.BalanceActionPreamble, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasBalanceActionPreamble, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <Button Content="{x:Bind ViewModel.BalanceActionText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasBalanceAction, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CredentialControlsEnabled, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                Click="OnBalanceAction" />
                        <TextBlock Text="{x:Bind ViewModel.Funding.Title}" Style="{StaticResource TcTitleSectionTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Funding.Message, Mode=OneWay}" Style="{StaticResource TcBodyTextStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.Funding.What}" Style="{StaticResource TcCaptionTextStyle}" TextWrapping="Wrap" />
                        <Button Content="{x:Bind ViewModel.Funding.Action, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.Funding.Enabled, Mode=OneWay}"
                                HorizontalAlignment="Left" MinHeight="44" Click="OnFundingAction" />
                    </StackPanel>
                </Border>

                <!--
                    The card that opens Settings (InferenceAccountSection,
                    PrivateAISettingsLinkCard, InferenceAccount.swift:125-145):
                    a gear, the core's settings title and Home's chevron; the
                    whole card is the button, its help text the core's.
                -->
                <Button x:Name="SettingsLinkCard"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Padding="14,12"
                        Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Visibility="{x:Bind ViewModel.Available, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.SettingsLinkTitle, Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind ViewModel.SettingsLinkHelp, Mode=OneWay}"
                        Click="OnSettingsLink">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="{ThemeResource TcInkSecondaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.SettingsLinkTitle, Mode=OneWay}"
                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TcInkPrimaryBrush}" TextWrapping="Wrap" />
                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" FontWeight="SemiBold"
                                  Foreground="{ThemeResource TcInkTertiaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </Button>

                <!--
                    INTERIM, listed in the PR: on the Mac the sign-in, the
                    tools and the switch below live in Settings' Private AI
                    section (PrivateAISettingsPanels). Settings is being
                    rebuilt in another slice (W16), so they stay here, after
                    the Mac's sections, until that section lands there.
                -->
                <!--
                    The credential this computer answers calls with, and it
                    comes before the tool list: without one, a connect has
                    nothing to offer, and a screen that hid the control
                    without saying why would leave a contributor pressing a
                    button that is not there.

                    Nothing on this card renders a key, a prefix, an id or an
                    account name. The payload carries no hole for one.

                    One button, and which one it is comes from the shared
                    table across the ABI rather than from anything decided
                    here. The sentence above it is the consequence of
                    pressing it, drawn from the same call that chose it, so a
                    button that opens a browser and mints a key at a third
                    party can never appear without the line saying so.
                -->
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind ViewModel.Available, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.CredentialTitle, Mode=OneWay}"
                                   Style="{StaticResource TcTitleSectionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CredentialWhat, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasCredentialWhat, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            One line per tone, chosen from the tone and never
                            from the text, exactly as the listener row below
                            is. Only the clear one, which is the one meaning a
                            key is kept here, is green.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.CredentialStateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.CredentialIsNeutral, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CredentialStateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.CredentialIsHeld, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcBlueBrandBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CredentialStateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.CredentialIsClear, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.CredentialStateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.CredentialIsRefused, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcCoralTextBrush}"
                                   TextWrapping="Wrap" />
                        <!--
                            F10: the last NEAR AI sign-in was refused as
                            another account, in the approved mismatch words.
                            The account section in Settings offers what to do.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.LoginMismatchLine, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasLoginMismatchLine, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcCoralTextBrush}"
                                   TextWrapping="Wrap" />
                        <!--
                            What pressing the button below costs, or what
                            forgetting does not do. Bound to the same action
                            the button is, so neither can be drawn without
                            the other.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.CredentialActionPreamble, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasCredentialActionPreamble, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <Button Content="{x:Bind ViewModel.CredentialActionText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowCredentialSignIn, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SignInTooltip, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CredentialControlsEnabled, Mode=OneWay}"
                                Style="{StaticResource TcPrimaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="OnCredentialAction" />
                        <Button Content="{x:Bind ViewModel.CredentialActionText, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowCredentialOtherAction, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CredentialControlsEnabled, Mode=OneWay}"
                                HorizontalAlignment="Left"
                                Click="OnCredentialAction" />
                    </StackPanel>
                </Border>

                <!--
                    The tools on this computer, and they come FIRST. Connecting
                    one is what a contributor came here to do; the switch below
                    is the kill switch over all of them, not the first question.

                    Every action is one tool at a time. There is no "connect
                    all", and nothing on this screen writes two files.

                    Each row is painted from its state and never from whether
                    its settings file names this computer. A value in a file is
                    not evidence that a call was ever answered, and only the
                    answering state is drawn in the working colour.
                -->
                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind ViewModel.Available, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.HarnessesTitle, Mode=OneWay}"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.HarnessesPrecedenceTooltip, Mode=OneWay}"
                                   Style="{StaticResource TcTitleSectionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.HarnessesWhat, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasHarnessesWhat, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            What today's calls cost, and what that figure
                            leaves out. Both are shown or neither is: an
                            amount nobody could read draws no line, and the
                            scope sentence alone would qualify a number that
                            is not on screen.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.HarnessesSpend, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasHarnessesSpend, Mode=OneWay}"
                                   Style="{StaticResource TcBodyTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.HarnessesSpendScope, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasHarnessesSpend, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            Nothing found, said in terms of what was looked for.
                            Drawn only once a list has actually come back, so an
                            unread list is not reported as an empty machine.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.HarnessesNoneFound, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasNoHarnesses, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            Why a connect is not on offer. Once, above the
                            rows, because the fact is about the destination
                            this app would answer from and not about any one
                            tool, and absent entirely on a daemon that does
                            not gate connects: telling somebody to sign in
                            before connecting a tool they can connect right
                            now would be false.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.HarnessesCredentialNotice, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasHarnessesCredentialNotice, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGoldTextBrush}"
                                   TextWrapping="Wrap" />
                        <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Harnesses, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HarnessRowViewModel">
                                    <StackPanel Spacing="12" Margin="0,12,0,0" Padding="20"
                                                Background="{ThemeResource TcSurfaceInsetBrush}"
                                                CornerRadius="{StaticResource TcCardCornerRadius}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Padding="12" Background="{ThemeResource TcSurfaceCardBrush}"
                                                    CornerRadius="{StaticResource TcCardCornerRadius}">
                                                <FontIcon Glyph="&#xE756;" FontSize="20"
                                                          Foreground="{ThemeResource TcGreenTextBrush}"
                                                          AutomationProperties.AccessibilityView="Raw" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TcTitleCardTextStyle}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <Button Content="{x:Bind ConnectText}"
                                                        Style="{StaticResource TcPrimaryButtonStyle}"
                                                        Visibility="{x:Bind CanConnect}"
                                                        Tag="{x:Bind Id}" Click="OnConnectHarness" />
                                                <Button Content="{x:Bind DisconnectText}"
                                                        Visibility="{x:Bind CanDisconnect}"
                                                        Tag="{x:Bind Id}" Click="OnDisconnectHarness" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{x:Bind StateText}"
                                                   Visibility="{x:Bind StateIsPlain}"
                                                   Style="{StaticResource TcCaptionTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind StateText}"
                                                   Visibility="{x:Bind ReadsAsWorking}"
                                                   Style="{StaticResource TcCaptionTextStyle}"
                                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind LastCallText}"
                                                   Visibility="{x:Bind HasLastCallText}"
                                                   Style="{StaticResource TcCaptionTextStyle}"
                                                   TextWrapping="Wrap" />
                                        <Expander Header="{x:Bind SettingsTitle}"
                                                  IsExpanded="{x:Bind IsSettingsExpanded, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Stretch">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="{x:Bind ConfigPath}"
                                                           Visibility="{x:Bind HasConfigPath}"
                                                           Style="{StaticResource TcMonoCodeTextStyle}"
                                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind ConnectCommand}"
                                                           Visibility="{x:Bind HasConnectCommand}"
                                                           Style="{StaticResource TcMonoCodeTextStyle}"
                                                           IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!--
                            A tool holding an old setting in a process that is
                            still running. Shown only once a write has actually
                            happened, and in the plain colour: nothing went
                            wrong here.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.Restart, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasRestart, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource TcSurfaceCardBrush}"
                        BorderBrush="{ThemeResource TcHairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource TcCardCornerRadius}"
                        Padding="14,12"
                        Visibility="{x:Bind ViewModel.Available, Mode=OneWay}">
                    <StackPanel Spacing="10">
                        <Expander Header="{x:Bind ViewModel.Title, Mode=OneWay}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="10">
                        <TextBlock Text="{x:Bind ViewModel.What, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            What turning it on exposes. Here as well as in the
                            first run offer: a contributor who declined and
                            came back later is making the same decision and is
                            owed the same sentence.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.Exposure, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <ToggleSwitch Header="{x:Bind ViewModel.ToggleText, Mode=OneWay}"
                                      IsOn="{x:Bind ViewModel.Enabled, Mode=OneWay}"
                                      IsEnabled="{x:Bind ViewModel.ControlsEnabled, Mode=OneWay}"
                                      Toggled="OnToggled" />
                            </StackPanel>
                        </Expander>
                        <!--
                            One line per tone, chosen from the tone and never
                            from the text: three of the sentences begin with
                            the same two words, so a colour picked by reading
                            the sentence would be picked by matching a prefix.
                            Only the clear one is green.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StateIsNeutral, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StateIsHeld, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcBlueBrandBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StateIsClear, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGreenTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StateIsAttention, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcGoldTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.StateText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StateIsRefused, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcCoralTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ServingText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasServingText, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.AppliesAtOnce, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   TextWrapping="Wrap" />
                        <!--
                            A write the daemon did not confirm. The payload's
                            sentence, and absent when there is nothing to say.
                        -->
                        <TextBlock Text="{x:Bind ViewModel.Notice, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasNotice, Mode=OneWay}"
                                   Style="{StaticResource TcCaptionTextStyle}"
                                   Foreground="{ThemeResource TcCoralTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
