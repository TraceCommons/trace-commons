<?xml version="1.0" encoding="utf-8"?>
<!--
    The animated first run, ported from the Mac (macos/Sources/TraceCommonsApp/Views/FirstRun,
    OnboardingCoordinatorView.swift): Welcome, Tools, Private AI, Traces,
    Uses, Terms and Join over one stage. The stage is drawn with Win2D behind
    the steps; every word is the core's (tc_first_run_copy_json) and the code
    behind builds each step from it. Dark only, as on the Mac (Ron, 2026-11-05).

    XML comments cannot contain a double hyphen.
-->
<Window
    x:Class="TraceCommons.App.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml">

    <Grid x:Name="Root" RequestedTheme="Dark">
        <canvas:CanvasControl x:Name="Stage" IsTabStop="False" AutomationProperties.AccessibilityView="Raw" />
        <!-- The window's drag strip: the Mac hides the title bar and the stage runs under the window's buttons. -->
        <Grid x:Name="DragStrip" Height="32" VerticalAlignment="Top" Background="Transparent" AutomationProperties.AccessibilityView="Raw" />
        <Grid x:Name="Design" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="DesignScale" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentPresenter x:Name="OutgoingStep" Grid.Row="0" IsHitTestVisible="False" IsTabStop="False" />
            <ContentPresenter x:Name="CurrentStep" Grid.Row="0" />
            <StackPanel x:Name="Thread" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="0,14,0,0" Height="28">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ThreadLift" />
                </StackPanel.RenderTransform>
            </StackPanel>
            <Grid x:Name="Footer" Grid.Row="1" Margin="40,0,40,28" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Click="OnBack" />
                <Button x:Name="LinkButton" Grid.Column="2" Visibility="Collapsed" Click="OnLink" />
                <Button x:Name="ContinueButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}" Click="OnContinue" />
            </Grid>
        </Grid>
    </Grid>
</Window>
