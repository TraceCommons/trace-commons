    "textTertiary": { "hex": "#b4b4bc", "note": "Raised from #a9a9b0 for 4.5:1 on glass. Light: 4.8:1 or more on every light ground it is drawn on (the scene, a well, the map field); #6a6a71 was 4.12 on mapFieldOuter.", "light": { "hex": "#5c5c63" } },
    "textSecondaryHighContrast": { "hex": "#e6e6ec", "note": "textSecondary under Increase Contrast.", "light": { "hex": "#2a2a2e" } },
