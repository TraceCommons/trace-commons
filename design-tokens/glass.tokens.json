    "placeholder": { "hex": "#ffffff", "alpha": 0.46, "note": "A text field's prompt: #1146's .tc-input::placeholder, white, raised from #1146's 30% to the least that clears 4.5:1 on the field fill over every ground a field is drawn on (owner ruling, 2026-10-07: hold the WCAG floors; a prompt is text). Dark 4.61 or more (30% was 2.60); light 4.52 or more (30% was 2.03).", "light": { "hex": "#000000", "alpha": 0.57 } },
    "hairlineHighContrast": { "hex": "#ffffff", "alpha": 0.4, "note": "hairline under Increase Contrast. Light: 3:1 or more on every light ground (0.4 was 2.82).", "light": { "hex": "#000000", "alpha": 0.45 } },
    "edgeHighContrast": { "hex": "#f2f2f4", "alpha": 0.4, "note": "A painted surface's edge under Increase Contrast: a solid 1pt stroke at 40% text colour (spec, Appearance). Light: 55%, for 3:1 or more on every light ground (40% was 2.44).", "light": { "hex": "#1d1d1f", "alpha": 0.55 } },
