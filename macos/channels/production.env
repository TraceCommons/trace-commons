# The production channel of the macOS app: today's bundle values.
#
# macos/scripts/channel.sh reads this file when TC_CHANNEL is unset or
# `production`. It is data, not a script: one KEY=VALUE per line, read
# without evaluating anything, every key required. A production bundle built
# from it has the same Info.plist as one built before the channel files
# existed (scripts/ci/test-macos-channel-plist.sh holds that).

# Info.plist identity. The bundle name is also the .app and DMG file name.
# It stays the name existing installs carry on disk: macOS shows a bundle's
# localized display name only while its filename matches CFBundleName, and
# Sparkle updates an install in place under its old filename. The display
# name is what Finder, Launchpad, the app switcher, the app menu and the
# DMG volume show; make-app-bundle.sh writes it into
# Contents/Resources/en.lproj/InfoPlist.strings.
TC_BUNDLE_ID=ai.tracecommons.shell
TC_BUNDLE_NAME=Near.ai
TC_DISPLAY_NAME=Near AI Gateway
# The release DMG's volume name (owner, 2026-11-11). The app inside keeps
# TC_BUNDLE_NAME and TC_DISPLAY_NAME.
TC_DMG_VOLUME_NAME=Gateway

# The URL scheme invite links carry, and the URL type's name.
TC_URL_SCHEME=tracecommons
TC_URL_TYPE_NAME=ai.tracecommons.shell.invite

# The Sparkle appcast, and the name of the environment variable that holds
# the EdDSA public key it is signed for. With that variable unset the bundle
# gets no feed and no key.
TC_SPARKLE_FEED_URL=https://storage.googleapis.com/tracecommons-flatpak/updates/appcast.xml
TC_SPARKLE_KEY_VAR=TC_SPARKLE_PUBLIC_ED_KEY

# Signing, relative to macos/: the entitlements file, the Developer ID
# provisioning profile, and the variable that may override the profile path.
TC_ENTITLEMENTS=entitlements.plist
TC_PROFILE=TraceCommons-DeveloperID.provisionprofile
TC_PROFILE_VAR=TC_MACOS_PROVISION_PROFILE

# The app icon's Icon Composer document, relative to the repository root:
# the NEAR AI tile, compiled by scripts/make-icon-document.sh.
TC_ICON_SOURCE=macos/icons/production/AppIcon.icon

# Cargo features for the FFI dylib and for the bundled CLI, one value each:
# cargo spells a feature differently from the crate that defines it than
# through a dependency. Production adds none.
TC_FFI_CARGO_FEATURES=
TC_CLI_CARGO_FEATURES=

# Anonymous campaign content. A failed read uses the default compiled into the app.
TC_PRIVATE_AI_CAMPAIGN_URL=https://storage.googleapis.com/tracecommons-flatpak/updates/private-ai-campaign.json
