# The staging channel of the macOS app, installed beside the production one
# and sharing nothing with it (staging design, sections 4.1, 4.2, 4.5, 4.7).
#
# macos/scripts/channel.sh reads this file when TC_CHANNEL is `staging`. It
# is data, not a script: one KEY=VALUE per line, read without evaluating
# anything, every key required.
#
# scripts/ci/check-release-staging-feature.sh requires this file to name the
# feature and refuses it naming any production destination, comments
# included.

# Info.plist identity. The bundle name is also the .app, DMG and volume name.
TC_BUNDLE_ID=ai.tracecommons.shell.staging
TC_BUNDLE_NAME=Near.ai Staging

# Its own URL scheme, so a production invite link never opens the staging
# app (4.5). The dylib's deep-link parser accepts only this one.
TC_URL_SCHEME=tracecommons-staging
TC_URL_TYPE_NAME=ai.tracecommons.shell.staging.invite

# The staging appcast in the staging bucket, and the variable that holds the
# staging Sparkle public key (4.7). A production appcast cannot update this
# app, and with the variable unset the bundle gets no feed at all.
TC_SPARKLE_FEED_URL=https://storage.googleapis.com/tc-staging-updates-20261022/staging/appcast.xml
TC_SPARKLE_KEY_VAR=TC_STAGING_SPARKLE_PUBLIC_ED_KEY

# Signing, relative to macos/. The entitlements carry the staging keychain
# group; the profile is the staging App ID's.
TC_ENTITLEMENTS=entitlements-staging.plist
TC_PROFILE=TraceCommons-Staging-DeveloperID.provisionprofile
TC_PROFILE_VAR=TC_STAGING_MACOS_PROVISION_PROFILE

# The app icon's Icon Composer document, relative to the repository root:
# the production tile plus an amber hazard ribbon across the top-right
# corner, so the staging app is told apart by colour before shape (spec
# open item 2).
TC_ICON_SOURCE=macos/icons/staging/AppIcon.icon

# Cargo features for the FFI dylib and for the bundled CLI: the staging
# channel, spelled through the dylib's dependency for the first and on the
# defining crate for the second. make-app-bundle.sh refuses a bundle whose
# CLI does not report this channel.
TC_FFI_CARGO_FEATURES=trace-commons-contributor/near-ai-staging
TC_CLI_CARGO_FEATURES=near-ai-staging

# Anonymous campaign content. A failed read uses the default compiled into the app.
TC_PRIVATE_AI_CAMPAIGN_URL=https://storage.googleapis.com/tc-staging-updates-20261022/staging/private-ai-campaign.json
